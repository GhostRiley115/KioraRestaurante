@{
    Layout = "~/Views/Shared/_Layout.cshtml";
}
@section Styles {
    <link rel="stylesheet" href="~/css/admin.css" asp-append-version="true" />
    @await RenderSectionAsync("Styles", required: false)
}
<div class="container admin-pagina">
    <span class="admin-sobretitulo">KIORA · @(User.IsInRole("Administrador")?"ADMINISTRAÇÃO":"EQUIPE")</span>
    <!-- Links acessíveis em todas as telas administrativas. -->
    <div class="admin-shell">
    <aside class="admin-lateral">
        <details class="admin-menu" open>
        <summary>Menu de gerenciamento</summary>
        <partial name="~/Views/Shared/_MenuGerenciamento.cshtml" />
        </details>
    </aside>
    <div class="admin-conteudo" id="gerenciamento">
    @if (TempData["AdminSucesso"] is string sucesso) { <p class="admin-aviso" role="status">@sucesso</p> }
    @if (TempData["AdminErro"] is string erro) { <p class="admin-erro" role="alert">@erro</p> }
    @RenderBody()
    </div>
    </div>
</div>
@section Scripts {
    <script src="~/js/admin.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
}
