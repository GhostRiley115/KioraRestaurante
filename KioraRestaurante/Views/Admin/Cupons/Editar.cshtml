@model KioraRestaurante.DTOs.Cupons.SalvarCupomDTO
@{ ViewData["Title"] = Model.Id.HasValue ? "Editar cupom" : "Criar cupom"; }
<a asp-action="Index">← Cupons</a><h1>@ViewData["Title"]</h1>
<form asp-action="Editar" method="post" class="admin-box cupom-form">
    <div asp-validation-summary="All" class="pedido-erros" role="alert"></div>
    <input asp-for="Id" type="hidden" /><input asp-for="Versao" type="hidden" />
    <label asp-for="Codigo">Código</label><input asp-for="Codigo" class="form-control" maxlength="40" readonly="@Model.Id.HasValue" />
    <small>De 3 a 40 letras sem acento, números, hífen ou sublinhado. Após criar, o código é mantido.</small>
    <label asp-for="Descricao">Descrição</label><input asp-for="Descricao" class="form-control" maxlength="200" />
    <label asp-for="Parceiro">Parceiro (opcional)</label><input asp-for="Parceiro" class="form-control" maxlength="100" />
    <div class="row g-3"><div class="col-md-6"><label asp-for="Tipo">Tipo de desconto</label><select asp-for="Tipo" class="form-select"><option value="0">Porcentagem</option><option value="1">Valor em reais</option></select></div>
    <div class="col-md-6"><label asp-for="Valor">Valor do desconto</label><input asp-for="Valor" type="text" inputmode="decimal" class="form-control" /></div>
    <div class="col-md-6"><label asp-for="ValorMinimoProdutos">Mínimo em produtos (R$)</label><input asp-for="ValorMinimoProdutos" type="text" inputmode="decimal" class="form-control" /></div>
    <div class="col-md-6"><label asp-for="DescontoMaximo">Desconto máximo (R$, opcional)</label><input asp-for="DescontoMaximo" type="text" inputmode="decimal" class="form-control" /></div>
    <div class="col-md-6"><label asp-for="InicioLocal">Início · Brasília</label><input asp-for="InicioLocal" type="datetime-local" asp-format="{0:yyyy-MM-ddTHH:mm}" class="form-control" /></div>
    <div class="col-md-6"><label asp-for="FimLocal">Fim · Brasília</label><input asp-for="FimLocal" type="datetime-local" asp-format="{0:yyyy-MM-ddTHH:mm}" class="form-control" /></div>
    <div class="col-md-6"><label asp-for="LimiteTotal">Limite total (opcional)</label><input asp-for="LimiteTotal" class="form-control" min="1" /></div>
    <div class="col-md-6"><label asp-for="LimitePorCliente">Limite por cliente</label><input asp-for="LimitePorCliente" class="form-control" min="1" /></div></div>
    <label class="mt-3"><input asp-for="Ativo" /> Cupom ativo</label>
    <p>Pausar impede novas reservas. Pedidos já confirmados mantêm o desconto registrado.</p>
    <button type="submit" class="pedido-botao">Salvar cupom</button>
</form>
