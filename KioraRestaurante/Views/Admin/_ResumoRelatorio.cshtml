@model RelatorioAdminDTO
@{
    var c=CultureInfo.GetCultureInfo("pt-BR"); var r=Model; var a=r.Atual;
    var maxDia=Math.Max(1m,r.Dias.Select(d=>d.Delivery+d.Salao).DefaultIfEmpty().Max());
    var maxHora=Math.Max(1,r.Horas.Select(h=>Math.Max(h.Delivery+h.Salao,h.Reservas)).DefaultIfEmpty().Max());
    var picoVendas=r.Horas.OrderByDescending(h=>h.Delivery+h.Salao).ThenBy(h=>h.Hora).FirstOrDefault();
    var picoReservas=r.Horas.OrderByDescending(h=>h.Reservas).ThenBy(h=>h.Hora).FirstOrDefault();
    string P(decimal valor)=>valor.ToString("0.####",CultureInfo.InvariantCulture);
}
<div class="admin-secao-topo admin-periodo-titulo"><div><span class="admin-sobretitulo">RESULTADOS DO PERÍODO · @(r.Filtros.Canal=="todos"?"TODOS OS CANAIS":r.Filtros.Canal=="salao"?"SALÃO":"DELIVERY")</span><h2>@r.Filtros.Inicio?.ToString("dd/MM/yyyy") a @r.Filtros.Fim?.ToString("dd/MM/yyyy")</h2></div><span class="admin-suave">Comparação: @r.Filtros.CompararInicio?.ToString("dd/MM/yyyy") a @r.Filtros.CompararFim?.ToString("dd/MM/yyyy")</span></div>
<div class="admin-resumo admin-kpis">
<article class="admin-card"><span>Vendas confirmadas</span><strong>@a.Total.ToString("C",c)</strong><small>Inclui @a.Frete.ToString("C",c) de frete</small><span class="admin-variacao">@(r.Variacao.HasValue?(r.Variacao>0?"↑ ":r.Variacao<0?"↓ ":"→ ")+Math.Abs(r.Variacao.Value).ToString("0.0",c)+"% no comparativo":"Sem base de vendas para comparar")</span></article>
<article class="admin-card admin-canal-delivery"><span>Delivery</span><strong>@a.Delivery.ToString("C",c)</strong><small>Pedidos aprovados ou dinheiro entregue</small></article>
<article class="admin-card admin-canal-salao"><span>Restaurante físico</span><strong>@a.Salao.ToString("C",c)</strong><small>Contas fechadas · recebimento externo</small></article>
<article class="admin-card"><span>Ticket médio</span><strong>@a.TicketMedio.ToString("C",c)</strong><small>@a.Quantidade vendas · média por pedido ou conta</small></article>
</div>
<section class="admin-box admin-grafico-box" aria-labelledby="titulo-vendas">
<div class="admin-secao-topo"><div><h2 id="titulo-vendas">Vendas ao longo dos dias</h2><p class="admin-suave">Toque nas barras ou use Tab para consultar os valores.</p></div><div class="admin-legenda"><span><i class="admin-cor-delivery"></i>Delivery</span><span><i class="admin-cor-salao"></i>Restaurante físico</span></div></div>
<output class="admin-grafico-leitura" aria-live="polite">Total no período: @a.Total.ToString("C",c)</output>
<div class="admin-grafico-scroll" tabindex="0" role="region" aria-label="Gráfico diário com rolagem horizontal quando necessário">
<div class="admin-grafico-dias" style="--dias:@r.Dias.Count">
@foreach(var d in r.Dias){var texto=$"{d.Dia:dd/MM}: delivery {d.Delivery.ToString("C",c)}; salão {d.Salao.ToString("C",c)}";
<button type="button" class="admin-barra-dia" data-grafico-detalhe="@texto" aria-label="@texto" title="@texto"><span class="admin-barra-area"><span class="admin-barra-salao" style="height:@(P(d.Salao/maxDia*100))%"></span><span class="admin-barra-delivery" style="height:@(P(d.Delivery/maxDia*100))%"></span></span><span class="admin-dia-label">@d.Dia.ToString("dd/MM")</span></button>}
</div></div>
<details class="admin-dados-grafico"><summary>Ver valores em tabela</summary><div class="admin-tabela-scroll"><table class="admin-tabela"><caption>Vendas por dia, em reais</caption><thead><tr><th>Dia</th><th>Delivery</th><th>Salão</th><th>Total</th></tr></thead><tbody>@foreach(var d in r.Dias){<tr><td>@d.Dia.ToString("dd/MM/yyyy")</td><td>@d.Delivery.ToString("C",c)</td><td>@d.Salao.ToString("C",c)</td><td>@((d.Delivery+d.Salao).ToString("C",c))</td></tr>}</tbody></table></div></details>
</section>
<div class="admin-relatorio-duas">
<section class="admin-box"><h2>Comparação de vendas</h2><p class="admin-suave">Os dois períodos usam os mesmos critérios e o canal selecionado.</p><div class="admin-tabela-scroll"><table class="admin-tabela admin-tabela-compacta"><thead><tr><th>Indicador</th><th>Selecionado</th><th>Comparação</th></tr></thead><tbody><tr><th>Delivery</th><td>@a.Delivery.ToString("C",c)</td><td>@r.Anterior.Delivery.ToString("C",c)</td></tr><tr><th>Salão</th><td>@a.Salao.ToString("C",c)</td><td>@r.Anterior.Salao.ToString("C",c)</td></tr><tr><th>Total</th><td>@a.Total.ToString("C",c)</td><td>@r.Anterior.Total.ToString("C",c)</td></tr><tr><th>Vendas</th><td>@a.Quantidade</td><td>@r.Anterior.Quantidade</td></tr><tr><th>Ticket médio</th><td>@a.TicketMedio.ToString("C",c)</td><td>@r.Anterior.TicketMedio.ToString("C",c)</td></tr></tbody></table></div></section>
<section class="admin-box"><h2>Descontos e promoções</h2><dl class="admin-indicadores-lista"><div><dt>Unidades vendidas em promoção</dt><dd>@a.UnidadesPromocionais</dd></div><div><dt>Descontos nos produtos</dt><dd>@a.DescontoCatalogo.ToString("C",c)</dd></div><div><dt>Cupons no delivery · @a.PedidosComCupom pedidos</dt><dd>@a.Cupons.ToString("C",c)</dd></div><div><dt>Descontos nas comandas</dt><dd>@a.DescontosComanda.ToString("C",c)</dd></div><div><dt>Vendas sem o frete</dt><dd>@a.ProdutosLiquidos.ToString("C",c)</dd></div></dl><p class="admin-suave">Promoção conta unidades com preço original maior que o preço vendido. Cupons e descontos da conta são exibidos separadamente.</p>@if(a.UnidadesSemHistoricoDesconto>0){<p class="admin-alerta">@a.UnidadesSemHistoricoDesconto unidade(s) antigas sem registro do preço original. Elas entram nas vendas, mas não na contagem de promoções.</p>}</section>
</div>
<section class="admin-box"><div class="admin-secao-topo"><h2>Produtos mais vendidos</h2><span class="admin-suave">Até 10 produtos · unidades vendidas</span></div>
@if(r.Produtos.Count==0){<p class="admin-vazio">Ainda não há vendas confirmadas neste período.</p>}else{<div class="admin-tabela-scroll"><table class="admin-tabela"><thead><tr><th>Produto</th><th>Unidades</th><th>Delivery</th><th>Salão</th><th>Em promoção</th><th>Valor dos itens</th></tr></thead><tbody>@foreach(var p in r.Produtos.Take(10)){<tr><td><strong>@p.Nome</strong><span class="admin-texto-bloco">#@p.Id</span></td><td>@p.Quantidade</td><td>@p.Delivery</td><td>@p.Salao</td><td>@p.Promocionais</td><td>@p.Valor.ToString("C",c)</td></tr>}</tbody></table></div>}
<p class="admin-suave mt-3">Combos contam como um produto. O valor dos itens considera a promoção do produto, antes de cupons e descontos na comanda.</p></section>
<section class="admin-box admin-grafico-box"><h2>Horários de maior movimento</h2><div class="admin-picos"><p><span>Maior volume de vendas</span><strong>@(picoVendas!=null && picoVendas.Delivery+picoVendas.Salao>0?$"{picoVendas.Hora:00}h às {picoVendas.Hora:00}h59":"Sem vendas no período")</strong></p><p><span>Horário mais reservado</span><strong>@(picoReservas?.Reservas>0?$"{picoReservas.Hora:00}h às {picoReservas.Hora:00}h59":"Sem reservas no período")</strong></p></div><p class="admin-suave">Delivery: hora do pedido confirmado. Salão: hora do fechamento da conta. Reservas: horário agendado de chegada, independente do canal financeiro. Em empate, aparece a primeira hora.</p>
<div class="admin-legenda"><span><i class="admin-cor-delivery"></i>Delivery</span><span><i class="admin-cor-salao"></i>Salão</span><span><i class="admin-cor-reserva"></i>Reservas</span></div>
<output class="admin-grafico-leitura" aria-live="polite">@r.ReservasPeriodo reservas válidas · @r.ReservasCanceladas canceladas ou expiradas no período</output>
<div class="admin-grafico-scroll" tabindex="0" role="region" aria-label="Gráfico de movimento por hora"><div class="admin-grafico-horas">
@foreach(var h in r.Horas){var texto=$"{h.Hora:00}h: {h.Delivery} pedidos delivery; {h.Salao} contas fechadas; {h.Reservas} reservas";
<button type="button" class="admin-barra-dia" data-grafico-detalhe="@texto" aria-label="@texto" title="@texto"><span class="admin-barra-area admin-barras-lado"><span class="admin-barras-vendas"><span class="admin-barra-salao" style="height:@(P((decimal)h.Salao/maxHora*100))%"></span><span class="admin-barra-delivery" style="height:@(P((decimal)h.Delivery/maxHora*100))%"></span></span><span class="admin-barra-reserva" style="height:@(P((decimal)h.Reservas/maxHora*100))%"></span></span><span class="admin-dia-label">@h.Hora.ToString("00")h</span></button>}
</div></div></section>
<details class="admin-box admin-criterios"><summary>Como os resultados são calculados</summary><p>Horário de Brasília. Delivery usa a data em que o pedido foi feito, incluindo pagamento aprovado ou dinheiro já entregue. Cancelados, recusados, reembolsados e pagamentos em conferência ficam fora. Pedidos com alteração financeira pendente aguardam conclusão do ajuste.</p><p>Salão usa a data de fechamento e o total da conta após descontos; mesas abertas não entram em vendas. O total de delivery inclui frete, mostrado também à parte. Estes são resultados gerenciais, não um extrato bancário.</p><p>A comparação padrão usa as mesmas datas do mês anterior, ajustando ao último dia quando necessário. Você pode escolher outros períodos no relatório. Reservas canceladas e expiradas não entram no pico; fila sem agendamento não é contada como reserva.</p></details>
