@model KioraRestaurante.ViewModels.ReservaFormViewModel
@{ ViewData["Title"]="Reservar uma mesa"; }
@section Styles { <link rel="stylesheet" href="~/css/reservas.css" asp-append-version="true" /> }
<section class="container reservas-pagina">
    <header class="reservas-cabecalho"><span>KIORA · À SUA MESA</span><h1>Um lugar para o seu próximo encontro</h1>
        <p>Informe quando pretende chegar. A equipe acompanha sua solicitação e acomoda o grupo em uma mesa disponível.</p>
        <a asp-action="Minhas" class="pedido-link">Minhas reservas e fila</a></header>
    <div class="reservas-grade">
        <section class="reservas-card"><h2>Faça sua reserva</h2>
            <div asp-validation-summary="All" class="pedido-erros" role="alert"></div>
            <!-- A chave acompanha reenvios: clicar duas vezes não cria duas reservas. -->
            <form asp-action="Criar" method="post" id="formReserva" data-horarios-url="@Url.Action("Horarios")">
                <input asp-for="Dados.ChaveSolicitacao" type="hidden" />
                <label asp-for="Dados.Nome">Nome de quem vai chegar</label><input asp-for="Dados.Nome" class="form-control" autocomplete="name" maxlength="100" required />
                <span asp-validation-for="Dados.Nome" class="pedido-erros"></span>
                <label asp-for="Dados.Telefone">Telefone com DDD</label><input asp-for="Dados.Telefone" class="form-control" type="tel" autocomplete="tel-national" maxlength="25" placeholder="(11) 99999-9999" required />
                <span asp-validation-for="Dados.Telefone" class="pedido-erros"></span>
                <label asp-for="Dados.Pessoas">Pessoas (incluindo crianças)</label>
                <select asp-for="Dados.Pessoas" class="form-select">@for(var i=1;i<=6;i++){<option value="@i">@i pessoa(s)</option>}</select>
                <label asp-for="Dados.Data">Data</label><input asp-for="Dados.Data" class="form-control" type="date" min="@Model.Hoje.ToString("yyyy-MM-dd")" max="@Model.Limite.ToString("yyyy-MM-dd")" />
                <label asp-for="Dados.Horario">Horário de chegada</label>
                <select asp-for="Dados.Horario" class="form-select">
                    <option value="">Selecione um horário</option>
                    @foreach(var h in Model.Horarios){<option value="@h.Horario" disabled="@(!h.Disponivel)">@h.Horario @(!h.Disponivel?"· lotado":"")</option>}
                </select>
                <p id="avisoHorarios" class="reservas-suave" role="status">A solicitação não garante uma mesa no horário. Apresente-se à portaria ao chegar.</p>
                <button class="pedido-botao" type="submit" name="tipo" value="reserva">Solicitar reserva</button>
                <!-- A fila é para quem pretende ir hoje, não uma reserva de data futura. -->
                <details class="reservas-fila"><summary>Não encontrou horário? Entrar na fila de hoje</summary>
                    <p>Use o mesmo nome, telefone e número de pessoas. Sua posição é definida após registrar a chegada na portaria. A data e o horário acima não são usados na fila.</p>
                    <button class="pedido-botao" type="submit" name="tipo" value="fila">Entrar na fila de hoje</button>
                </details>
            </form>
            <noscript><p>Sem JavaScript, escolha data e pessoas e confira os horários pelo formulário abaixo.</p>
                <form method="get"><label>Data <input type="date" name="data" required /></label><label>Pessoas <input name="pessoas" type="number" min="1" max="6" value="2" /></label><button>Consultar horários</button></form>
            </noscript>
        </section>
        <aside class="reservas-card reservas-regras"><h2>Antes de reservar</h2>
            <ul><li>Funcionamento: <strong>11h à meia-noite</strong>, horário de Brasília.</li>
                <li>Último horário reservável: <strong>23h20</strong>.</li>
                <li><strong>Sem limite de permanência.</strong> A equipe libera a mesa após fechar a conta e concluir a limpeza.</li>
                <li>Tolerância de atraso: <strong>15 minutos</strong>. Apresente-se à portaria dentro desse prazo.</li>
                <li>Grupos de <strong>1 a 6 pessoas</strong>. Para grupos maiores, fale com o restaurante.</li>
                <li>Não é necessário login. Guarde este navegador para acompanhar e cancelar.</li>
                <li>Logado, você pode consultar suas reservas em outros dispositivos usando a mesma conta.</li>
                <li>Você pode cancelar enquanto aguarda a chegada. Depois de sentar, procure o garçom.</li></ul>
            <p>A mesa é definida pela equipe na chegada. A posição na fila pode variar conforme o tamanho dos grupos; não apresentamos uma estimativa de espera sem dados reais.</p>
        </aside>
    </div>
</section>
@section Scripts { <partial name="_ValidationScriptsPartial" /><script src="~/js/reservas.js" asp-append-version="true"></script> }
