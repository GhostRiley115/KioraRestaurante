<!DOCTYPE html>

<html lang="pt-BR">

<head>

<!--
    ================================================================
    CONFIGURAÇÕES BÁSICAS DO DOCUMENTO
    ================================================================
-->

<!--
    Define a codificação de caracteres da página.

    UTF-8 permite a utilização correta de caracteres especiais
    da língua portuguesa.
-->
<meta charset="utf-8" />

<!--
    Configuração de responsividade.

    width=device-width:
    utiliza a largura real do dispositivo.

    initial-scale=1.0:
    define o nível inicial de zoom.
-->
<meta name="viewport"
      content="width=device-width, initial-scale=1.0" />

<!--
    Título da página.

    Cada View pode definir seu próprio título através
    de ViewData["Title"].
-->
<title>@ViewData["Title"] - Kiora</title>


<!--
    ================================================================
    IMPORT MAP
    ================================================================
-->

<script type="importmap"></script>


<!--
    ================================================================
    BOOTSTRAP CSS
    ================================================================
-->

<link rel="stylesheet"
      href="~/lib/bootstrap/dist/css/bootstrap.min.css" />


<!--
    ================================================================
    GOOGLE FONTS
    ================================================================
-->

<!-- Preconexão com o servidor do Google Fonts -->
<link rel="preconnect"
      href="https://fonts.googleapis.com">

<!-- Conexão segura com o servidor de fontes -->
<link rel="preconnect"
      href="https://fonts.gstatic.com"
      crossorigin>

<!--
    Fontes utilizadas na identidade visual da KIORA.

    Lato:
    textos, menus e botões.

    Playfair Display:
    títulos e elementos de destaque.
-->
<link href="https://fonts.googleapis.com/css2?family=Lato:wght@300;400;500;600;700&family=Playfair+Display:wght@500;600;700&display=swap"
      rel="stylesheet">


<!--
    ================================================================
    BOOTSTRAP ICONS
    ================================================================
-->

<link rel="stylesheet"
      href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" />


<!--
    ================================================================
    CSS PERSONALIZADO
    ================================================================
-->

<link rel="stylesheet"
      href="~/css/site.css"
      asp-append-version="true" />

<!-- Estilos dos modais compartilhados e dos formulários da conta. -->
<link rel="stylesheet" href="~/css/modais.css" asp-append-version="true" />

<link rel="stylesheet" 
      href="~/css/cardapio.css"
      asp-append-version="true" />


<!--
    ================================================================
    CSS GERADO PELO ASP.NET
    ================================================================
-->

<link rel="stylesheet"
      href="~/Kiora.styles.css"
      asp-append-version="true" />

<!--
================================================================
CSS DO CARRINHO
================================================================
-->

<link rel="stylesheet"
      href="~/css/carrinho.css"
      asp-append-version="true" />

<!--
================================================================
CSS DOS PEDIDOS
================================================================
-->

<link rel="stylesheet"
      href="~/css/pedido.css"
      asp-append-version="true" />

<!-- Estilo das telas administrativas de produto. -->
<link rel="stylesheet" href="~/css/produto-admin.css" asp-append-version="true" />
<!-- Cada página pode carregar seu CSS específico nesta seção. -->
@await RenderSectionAsync("Styles", required: false)
</head>

<body class="d-flex flex-column min-vh-100 @(ViewData["HomePage"] != null ? "pagina-home" : "")">


<!--
    ================================================================
    HEADER
    ================================================================
-->

<header>

    <!--
        ============================================================
        NAVBAR KIORA
        ============================================================
    -->

    <nav class="navbar navbar-expand-xl navbar-dark navbar-kiora">

        <div class="container">

            <!--
                ====================================================
                LOGO
                ====================================================
            -->

            <a class="navbar-brand"
               asp-controller="Home"
               asp-action="Index">

                <img src="~/imagens/logo-kiora-v.png"
                     alt="Kiora Japanese Cuisine"
                     class="logo-navbar">

            </a>


            <!--
                ====================================================
                BOTÃO DO MENU MOBILE
                ====================================================
            -->

            <button class="navbar-toggler"
                    type="button"
                    data-bs-toggle="collapse"
                    data-bs-target="#navbarKiora"
                    aria-controls="navbarKiora"
                    aria-expanded="false"
                    aria-label="Alternar navegação">

                <span class="navbar-toggler-icon"></span>

            </button>


            <!--
                ====================================================
                MENU PRINCIPAL
                ====================================================
            -->

            <div class="collapse navbar-collapse"
                 id="navbarKiora">

                <ul class="navbar-nav mx-auto align-items-lg-center">

                    <!-- INÍCIO -->

                    <li class="nav-item">

                        <a class="nav-link"
                           asp-controller="Home"
                           asp-action="Index">

                            Início

                        </a>

                    </li>


                    <!-- ================================================================
                         CARDÁPIO
                         ================================================================ -->

                    <li class="nav-item">

                        <a class="nav-link"
                           asp-controller="Home"
                           asp-action="Cardapio">

                            Cardápio

                        </a>

                    </li>

                    <!-- ================================================================
                         SOBRE NÓS
                         ================================================================ -->

                    <li class="nav-item">

                        <a class="nav-link"
                           asp-controller="Home"
                           asp-action="Sobre">

                            Sobre Nós

                        </a>

                    </li>


                    <!-- ================================================================
                         GALERIA
                         ================================================================ -->

                    <li class="nav-item">

                        <a class="nav-link" href="#">
                            Galeria
                        </a>

                    </li>


                    <!-- ================================================================
                         LOCALIZAÇÃO
                         ================================================================ -->

                    <li class="nav-item">

                        <a class="nav-link"
                           href="#"
                           data-bs-toggle="modal"
                           data-bs-target="#modalLocalizacao">

                            Localização

                        </a>

                    </li>


                    <!-- ================================================================
                         CONTATO
                         ================================================================ -->

                    <li class="nav-item">

                        <a class="nav-link"
                           href="#"
                           data-bs-toggle="modal"
                           data-bs-target="#modalContato">

                            Contato

                        </a>

                    </li>
                </ul>

                <!--
                    =================================================
                    ÁREA DE AÇÕES
                    =================================================
                -->

                    <!--
                        =================================================
                        RESERVAR MESA
                        =================================================
                    -->

                    <a class="btn btn-reserva"
                       href="#">

                        Reservar Mesa

                    </a>
            </div>

            <!-- AÇÕES SEMPRE VISÍVEIS: independentes do menu de páginas. -->
            <div class="navbar-acoes-fixas">
                    <!--
                        =================================================
                        CARRINHO
                        =================================================
                    -->

                    <button type="button"
                            id="abrirCarrinho"
                            class="carrinho-kiora position-relative"
                            data-bs-toggle="offcanvas"
                            data-bs-target="#painelCarrinho"
                            aria-controls="painelCarrinho"
                            aria-label="Abrir carrinho">

                        <i class="bi bi-cart3" aria-hidden="true"></i>

                        <span id="quantidadeCarrinho"
                              class="position-absolute top-0 start-100 translate-middle badge rounded-pill contador-carrinho"
                              hidden>
                            0
                        </span>
                    </button>
                <!-- MENU DO USUÁRIO: abre o painel lateral da conta. -->
                <button type="button" class="login-icon" id="menuUsuario"
                        data-bs-toggle="offcanvas" data-bs-target="#painelConta"
                        aria-controls="painelConta" aria-label="Abrir sua conta" title="Sua conta">
                    <i class="bi bi-person-circle" aria-hidden="true"></i>
                </button>
            </div>

        </div>

    </nav>

</header>


<!--
    ================================================================
    CONTEÚDO PRINCIPAL
    ================================================================
-->

<main role="main">

    @RenderBody()

</main>


<partial name="_PainelConta" />

<!-- MODAIS COMPARTILHADOS: cada partial mantém seu HTML e comentários. -->
<partial name="Modais/_ModalLogin" />
<partial name="Modais/_ModalCadastro" />
<partial name="Modais/_ModalEsqueciSenha" />
<partial name="Modais/_ModalLocalizacao" />
<partial name="Modais/_ModalContato" />

<!--
    ================================================================
    FOOTER
    ================================================================
-->

<footer class="footer-kiora">

    <div class="container-fluid">

        <div class="footer-content">

            <!--
                =====================================================
                LOGO
                =====================================================
            -->

            <div class="footer-logo-area">

                <img src="~/imagens/logo-kiora-v.png"
                     alt="Kiora Japanese Cuisine"
                     class="logo-footer">

            </div>


            <!--
                =====================================================
                FRASE INSTITUCIONAL
                =====================================================
            -->

            <div class="footer-frase">

                <p>

                    Uma experiência além do sabor.

                </p>

            </div>


            <!--
                =====================================================
                ENDEREÇO
                =====================================================
            -->

            <a href="#"
               class="footer-address-link"
               data-bs-toggle="modal"
               data-bs-target="#modalLocalizacao">

                <div class="footer-item">

                    <i class="bi bi-geo-alt footer-icon"></i>

                    <div>

                        <span>

                            Rua dos Pinheiros, 1234

                        </span>

                        <span>

                            Pinheiros, São Paulo - SP

                        </span>

                        <span>

                            01445-000

                        </span>

                    </div>

                </div>

            </a>


            <!--
                =====================================================
                TELEFONES
                =====================================================
            -->

            <div class="footer-item">

                <div class="footer-telefones">

                    <!-- TELEFONE -->

                    <div>

                        <i class="bi bi-telephone footer-icon"></i>

                        <span>

                            (11) 90000-1234

                        </span>

                    </div>


                    <!-- WHATSAPP -->

                    <div>

                        <i class="bi bi-whatsapp footer-icon"></i>

                        <span>

                            (11) 90000-1234

                        </span>

                    </div>

                </div>

            </div>


            <!--
                =====================================================
                E-MAIL
                =====================================================
            -->

            <div class="footer-item footer-email">

                <i class="bi bi-envelope footer-icon"></i>

                <span>

                    kiora_restaurante@gmail.com

                </span>

            </div>


            <!--
                =====================================================
                REDES SOCIAIS
                =====================================================
            -->

            <div class="footer-item footer-social">

                <div>

                    <span class="footer-social-title">

                        SIGA-NOS

                    </span>

                    <div class="footer-social-links">

                        <!-- INSTAGRAM -->

                        <a href="https://www.instagram.com/kiora_lamen/"
                           target="_blank"
                           rel="noopener noreferrer"
                           aria-label="Instagram">

                            <i class="bi bi-instagram"></i>

                        </a>


                        <!-- FACEBOOK -->

                        <a href="https://www.facebook.com/profile.php?id=61592931191936"
                           target="_blank"
                           rel="noopener noreferrer"
                           aria-label="Facebook">

                            <i class="bi bi-facebook"></i>

                        </a>


                        <!-- WHATSAPP -->

                        <a href="#"
                           aria-label="WhatsApp">

                            <i class="bi bi-whatsapp"></i>

                        </a>

                    </div>

                </div>

            </div>


            <!--
                =====================================================
                DIREITOS AUTORAIS
                =====================================================
            -->

            <div class="footer-direitos">

                <strong>

                    KIORA

                </strong>

                <span>

                    © 2026. Todos os direitos reservados.

                </span>


                <!-- POLÍTICAS -->

                <div class="footer-politicas">

                    <!-- POLÍTICA DE PRIVACIDADE -->

                    <a asp-area=""
                       asp-controller="Home"
                       asp-action="Privacy">

                        Política de Privacidade

                    </a>


                    <span>

                        |

                    </span>


                    <!-- TERMOS DE USO -->

                    <a href="#">

                        Termos de Uso

                    </a>

                </div>

            </div>

        </div>

    </div>

</footer>


<!--
    ================================================================
    JAVASCRIPT
    ================================================================
-->

<!-- Primeiro, cria o HTML do painel. -->
<partial name="_Carrinho" />

<!-- Depois, carrega as bibliotecas e os comportamentos. -->
<!-- jQuery -->
<script src="~/lib/jquery/dist/jquery.min.js"></script>

<!--
    Bootstrap Bundle

    Inclui o Popper.js necessário para Dropdown,
    Navbar, Modal e outros componentes.
-->
<script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>


<!-- JavaScript personalizado -->
<script src="~/js/site.js"
        asp-append-version="true"></script>

<!-- JavaScript carrinho -->
<!-- A conta depende do HTML dos modais e do Bootstrap carregados acima. -->
<script src="~/js/conta.js" asp-append-version="true"></script>

<script src="~/js/carrinho.js"
        asp-append-version="true"></script>

<!--
    ================================================================
    SCRIPTS ESPECÍFICOS DAS VIEWS
    ================================================================
-->

@await RenderSectionAsync("Scripts", required: false)

</body>

</html>
