<!DOCTYPE html>

<html lang="pt-BR">

<head>

<!--
    ================================================================
    CONFIGURAÇÕES BÁSICAS DO DOCUMENTO
    ================================================================
-->

<!--
    Define a codificação de caracteres da página.

    UTF-8 permite a utilização correta de caracteres especiais
    da língua portuguesa.
-->
<meta charset="utf-8" />

<!--
    Configuração de responsividade.

    width=device-width:
    utiliza a largura real do dispositivo.

    initial-scale=1.0:
    define o nível inicial de zoom.
-->
<meta name="viewport"
      content="width=device-width, initial-scale=1.0" />

<!--
    Título da página.

    Cada View pode definir seu próprio título através
    de ViewData["Title"].
-->
<title>@ViewData["Title"] - Kiora</title>


<!--
    ================================================================
    IMPORT MAP
    ================================================================
-->

<script type="importmap"></script>


<!--
    ================================================================
    BOOTSTRAP CSS
    ================================================================
-->

<link rel="stylesheet"
      href="~/lib/bootstrap/dist/css/bootstrap.min.css" />


<!--
    ================================================================
    GOOGLE FONTS
    ================================================================
-->

<!-- Preconexão com o servidor do Google Fonts -->
<link rel="preconnect"
      href="https://fonts.googleapis.com">

<!-- Conexão segura com o servidor de fontes -->
<link rel="preconnect"
      href="https://fonts.gstatic.com"
      crossorigin>

<!--
    Fontes utilizadas na identidade visual da KIORA.

    Lato:
    textos, menus e botões.

    Playfair Display:
    títulos e elementos de destaque.
-->
<link href="https://fonts.googleapis.com/css2?family=Lato:wght@300;400;500;600;700&family=Playfair+Display:wght@500;600;700&display=swap"
      rel="stylesheet">


<!--
    ================================================================
    BOOTSTRAP ICONS
    ================================================================
-->

<link rel="stylesheet"
      href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" />


<!--
    ================================================================
    CSS PERSONALIZADO
    ================================================================
-->

<link rel="stylesheet"
      href="~/css/site.css"
      asp-append-version="true" />


<!--
    ================================================================
    CSS GERADO PELO ASP.NET
    ================================================================
-->

<link rel="stylesheet"
      href="~/Kiora.styles.css"
      asp-append-version="true" />
```

</head>

<body class="d-flex flex-column min-vh-100 @(ViewData["HomePage"] != null ? "pagina-home" : "")">

```
<!--
    ================================================================
    HEADER
    ================================================================
-->

<header>

    <!--
        ============================================================
        NAVBAR KIORA
        ============================================================
    -->

    <nav class="navbar navbar-expand-lg navbar-dark navbar-kiora">

        <div class="container">

            <!--
                ====================================================
                LOGO
                ====================================================
            -->

            <a class="navbar-brand"
               asp-controller="Home"
               asp-action="Index">

                <img src="~/imagens/logo-kiora-v.png"
                     alt="Kiora Japanese Cuisine"
                     class="logo-navbar">

            </a>


            <!--
                ====================================================
                BOTÃO DO MENU MOBILE
                ====================================================
            -->

            <button class="navbar-toggler"
                    type="button"
                    data-bs-toggle="collapse"
                    data-bs-target="#navbarKiora"
                    aria-controls="navbarKiora"
                    aria-expanded="false"
                    aria-label="Alternar navegação">

                <span class="navbar-toggler-icon"></span>

            </button>


            <!--
                ====================================================
                MENU PRINCIPAL
                ====================================================
            -->

            <div class="collapse navbar-collapse"
                 id="navbarKiora">

                <ul class="navbar-nav mx-auto align-items-lg-center">

                    <!-- INÍCIO -->

                    <li class="nav-item">

                        <a class="nav-link"
                           asp-controller="Home"
                           asp-action="Index">

                            Início

                        </a>

                    </li>


                    <!-- CARDÁPIO -->

                    <li class="nav-item">

                        <a class="nav-link"
                           href="#">

                            Cardápio

                        </a>

                    </li>


                    <!-- SOBRE -->

                    <li class="nav-item">

                        <a class="nav-link"
                           asp-controller="Home"
                           asp-action="Sobre">

                            Sobre Nós

                        </a>

                    </li>


                    <!-- GALERIA -->

                    <li class="nav-item">

                        <a class="nav-link"
                           href="#">

                            Galeria

                        </a>

                    </li>


                    <!--
                        LOCALIZAÇÃO

                        Abre o modal de localização.
                    -->

                    <li class="nav-item">

                        <a class="nav-link"
                           href="#"
                           data-bs-toggle="modal"
                           data-bs-target="#modalLocalizacao">

                            Localização

                        </a>

                    </li>


                    <!-- CONTATO -->

                    <li class="nav-item">

                        <a class="nav-link"
                           href="#">

                            Contato

                        </a>

                    </li>

                </ul>


                <!--
                    =================================================
                    ÁREA DE AÇÕES
                    =================================================
                -->

                <div class="d-flex justify-content-center align-items-center gap-3 mt-3 mt-lg-0">

                    <!--
                        =================================================
                        MENU DO USUÁRIO
                        =================================================
                    -->

                    <div class="dropdown">

                        <a href="#"
                           class="login-icon dropdown-toggle"
                           id="menuUsuario"
                           role="button"
                           data-bs-toggle="dropdown"
                           aria-expanded="false"
                           aria-label="Menu do usuário"
                           title="Conta">

                           <i class="bi bi-person-circle"></i>

                           @if (User.Identity != null && User.Identity.IsAuthenticated)
                           {
                                <span class="nome-usuario-menu">

                                    @User.Identity.Name

                                </span>
                            }

                        </a>


                        <!-- MENU DO USUÁRIO -->

                        <ul class="dropdown-menu dropdown-menu-end menu-usuario"
                        aria-labelledby="menuUsuario">

                        @if (User.Identity != null && User.Identity.IsAuthenticated)
                        {
                            <!-- =====================================================
                                 USUÁRIO AUTENTICADO
                                 ===================================================== -->

                            <li>

                                <span class="dropdown-item-text usuario-logado">

                                    <i class="bi bi-person-circle"></i>

                                    Olá, @User.Identity.Name!

                                </span>

                            </li>

                            <li>

                                <hr class="dropdown-divider">

                            </li>


                            <!-- MEU PERFIL -->

                            <li>

                                <a class="dropdown-item"
                                   href="#">

                                    <i class="bi bi-person"></i>

                                    Meu perfil

                                </a>

                            </li>


                            <!-- DIVISOR -->

                            <li>

                                <hr class="dropdown-divider">

                            </li>


                            <!-- SAIR -->

                            <li>

                                <a class="dropdown-item"
                                   href="/Account/Logout">

                                    <i class="bi bi-box-arrow-right"></i>

                                    Sair

                                </a>

                            </li>
                        }
                        else
                        {
                            <!-- =====================================================
                                 USUÁRIO NÃO AUTENTICADO
                                 ===================================================== -->

                            <!-- ENTRAR -->

                            <li>

                                <a class="dropdown-item"
                                   href="#"
                                   data-bs-toggle="modal"
                                   data-bs-target="#modalLogin">

                                    <i class="bi bi-box-arrow-in-right"></i>

                                    Entrar

                                </a>

                            </li>


                            <!-- CRIAR CONTA -->

                            <li>

                                <a class="dropdown-item"
                                   href="#"
                                   data-bs-toggle="modal"
                                   data-bs-target="#modalCadastro">

                                    <i class="bi bi-person-plus"></i>

                                    Criar conta

                                </a>

                            </li>
                        }

                    </ul>

                    </div>


                    <!--
                        =================================================
                        CARRINHO
                        =================================================
                    -->

                    <a href="#"
                       class="carrinho-kiora position-relative"
                       aria-label="Carrinho">

                        <i class="bi bi-cart3"></i>

                        <span class="position-absolute top-0 start-100 translate-middle badge rounded-pill contador-carrinho">

                            0

                        </span>

                    </a>


                    <!--
                        =================================================
                        RESERVAR MESA
                        =================================================
                    -->

                    <a class="btn btn-reserva"
                       href="#">

                        Reservar Mesa

                    </a>

                </div>

            </div>

        </div>

    </nav>

</header>


<!--
    ================================================================
    CONTEÚDO PRINCIPAL
    ================================================================
-->

<main role="main">

    @RenderBody()

</main>


<!--
    ================================================================
    MODAL DE LOGIN KIORA
    ================================================================
-->

<div class="modal fade"
     id="modalLogin"
     tabindex="-1"
     aria-labelledby="modalLoginTitulo"
     aria-hidden="true">

    <div class="modal-dialog modal-dialog-centered modal-login-dialog">

        <div class="modal-content modal-login-kiora">

            <!-- BOTÃO FECHAR -->

            <button type="button"
                    class="btn-close modal-login-fechar"
                    data-bs-dismiss="modal"
                    aria-label="Fechar">

                <i class="bi bi-x-lg"></i>

            </button>


            <!-- CONTEÚDO -->

            <div class="modal-body modal-login-body">

                <!-- LOGO -->

                <div class="modal-login-logo">

                    <img src="~/imagens/logo-kiora-v.png"
                         alt="Kiora Japanese Cuisine">

                </div>


                <!-- CABEÇALHO -->

                <div class="modal-login-header">

                    <span class="modal-login-subtitulo">

                        BEM-VINDO À KIORA

                    </span>

                    <h2 id="modalLoginTitulo">

                        Entre na sua conta

                    </h2>

                    <p>

                        Acesse para continuar sua experiência.

                    </p>

                </div>


                <!-- FORMULÁRIO -->

                <form id="formLogin">

                    <!-- Mensagem de retorno do login -->
                    <div id="mensagemLogin"
                         class="mensagem-kiora"
                         role="alert"
                         style="display: none;">

                    </div>

                    <!-- E-MAIL -->

                    <div class="modal-login-grupo">

                        <label for="loginEmail">

                            E-mail

                        </label>

                        <div class="modal-login-input">

                            <i class="bi bi-envelope"></i>

                            <input type="email"
                                   id="loginEmail"
                                   name="email"
                                   placeholder="Digite seu e-mail"
                                   autocomplete="email"
                                   required>

                        </div>

                    </div>


                    <!-- SENHA -->

                    <div class="modal-login-grupo">

                        <label for="loginSenha">

                            Senha

                        </label>

                        <div class="modal-login-input">

                            <i class="bi bi-lock"></i>

                            <input type="password"
                                   id="loginSenha"
                                   name="senha"
                                   placeholder="Digite sua senha"
                                   autocomplete="current-password"
                                   required>

                            <button type="button"
                                    class="modal-login-olho"
                                    id="btnMostrarSenha"
                                    aria-label="Mostrar senha">

                                <i class="bi bi-eye"
                                   id="iconeSenha"></i>

                            </button>

                        </div>

                    </div>


                    <!-- ESQUECI SENHA -->

                    <div class="modal-login-opcoes">

                        <a href="#">

                            Esqueci minha senha

                        </a>

                    </div>


                    <!-- ENTRAR -->

                    <button type="submit"
                            class="btn-modal-login">

                        ENTRAR

                    </button>


                    <!-- DIVISOR -->

                    <div class="modal-login-divisor">

                        <span>

                            ou

                        </span>

                    </div>


                    <!-- CADASTRO -->

                    <div class="modal-login-cadastro">

                        <p>

                            Ainda não possui uma conta?

                        </p>

                        <a href="#"
                           data-bs-dismiss="modal"
                           data-bs-toggle="modal"
                           data-bs-target="#modalCadastro">

                            Criar conta

                        </a>

                    </div>

                </form>

            </div>

        </div>

    </div>

</div>


<!--
    ================================================================
    MODAL DE CADASTRO KIORA
    ================================================================
-->

<div class="modal fade"
     id="modalCadastro"
     tabindex="-1"
     aria-labelledby="modalCadastroTitulo"
     aria-hidden="true">

    <div class="modal-dialog modal-dialog-centered modal-cadastro-dialog">

        <div class="modal-content modal-cadastro-kiora">

            <!-- BOTÃO FECHAR -->

            <button type="button"
                    class="btn-close modal-cadastro-fechar"
                    data-bs-dismiss="modal"
                    aria-label="Fechar">

                <i class="bi bi-x-lg"></i>

            </button>


            <div class="modal-body modal-cadastro-body">

                <!-- LOGO -->

                <div class="modal-cadastro-logo">

                    <img src="~/imagens/logo-kiora-v.png"
                         alt="Kiora Japanese Cuisine">

                </div>


                <!-- CABEÇALHO -->

                <div class="modal-cadastro-header">

                    <span class="modal-cadastro-subtitulo">

                        BEM-VINDO À KIORA

                    </span>

                    <h2 id="modalCadastroTitulo">

                        Crie sua conta

                    </h2>

                    <p>

                        Cadastre-se para aproveitar sua experiência KIORA.

                    </p>

                </div>


                <!--
                    ====================================================
                    FORMULÁRIO DE CADASTRO
                    ====================================================
                -->

                <form id="formCadastro">


                    <!--
                        =================================================
                        MENSAGEM DO CADASTRO
                        =================================================

                        Esta área começa escondida.

                        O JavaScript irá utilizá-la para informar
                        visualmente o resultado do cadastro.

                        Exemplos:

                        Sucesso:
                        "Conta criada com sucesso!"

                        Erro:
                        "Este e-mail já está cadastrado."

                        A classe visual será definida pelo JavaScript.
                    -->

                    <div id="mensagemCadastro"
                         class="mensagem-kiora"
                         role="alert"
                         style="display: none;">

                    </div>


                    <!--
                        =================================================
                        NOME
                        =================================================
                    -->

                    <div class="modal-cadastro-grupo">

                        <label for="cadastroNome">

                            Nome

                        </label>

                        <div class="modal-cadastro-input">

                            <i class="bi bi-person"></i>

                            <input type="text"
                                   id="cadastroNome"
                                   name="Nome"
                                   placeholder="Digite seu nome"
                                   autocomplete="name"
                                   required>

                        </div>

                    </div>


                    <!--
                        =================================================
                        E-MAIL
                        =================================================
                    -->

                    <div class="modal-cadastro-grupo">

                        <label for="cadastroEmail">

                            E-mail

                        </label>

                        <div class="modal-cadastro-input">

                            <i class="bi bi-envelope"></i>

                            <input type="email"
                                   id="cadastroEmail"
                                   name="Email"
                                   placeholder="Digite seu e-mail"
                                   autocomplete="email"
                                   required>

                        </div>

                    </div>


                    <!--
                        =================================================
                        SENHA
                        =================================================
                    -->

                    <div class="modal-cadastro-grupo">

                        <label for="cadastroSenha">

                            Senha

                        </label>

                        <div class="modal-cadastro-input">

                            <i class="bi bi-lock"></i>

                            <input type="password"
                                   id="cadastroSenha"
                                   name="Senha"
                                   placeholder="Digite sua senha"
                                   autocomplete="new-password"
                                   required>

                            <button type="button"
                                    class="modal-cadastro-olho"
                                    id="btnMostrarCadastroSenha"
                                    aria-label="Mostrar senha">

                                <i class="bi bi-eye"
                                   id="iconeCadastroSenha"></i>

                            </button>

                        </div>

                    </div>


                    <!--
                        =================================================
                        CONFIRMAR SENHA
                        =================================================

                        ConfirmarSenha existe somente no ViewModel.

                        Ela NÃO é armazenada na tabela Usuarios.
                    -->

                    <div class="modal-cadastro-grupo">

                        <label for="cadastroConfirmarSenha">

                            Confirmar senha

                        </label>

                        <div class="modal-cadastro-input">

                            <i class="bi bi-lock-fill"></i>

                            <input type="password"
                                   id="cadastroConfirmarSenha"
                                   name="ConfirmarSenha"
                                   placeholder="Confirme sua senha"
                                   autocomplete="new-password"
                                   required>

                            <button type="button"
                                    class="modal-cadastro-olho"
                                    id="btnMostrarConfirmarSenha"
                                    aria-label="Mostrar senha">

                                <i class="bi bi-eye"
                                   id="iconeConfirmarSenha"></i>

                            </button>

                        </div>

                    </div>


                    <!--
                        =================================================
                        BOTÃO CADASTRAR
                        =================================================
                    -->

                    <button type="submit"
                            class="btn-modal-cadastro">

                        CRIAR CONTA

                    </button>


                    <!--
                        =================================================
                        LINK PARA LOGIN
                        =================================================
                    -->

                    <div class="modal-cadastro-login">

                        <p>

                            Já possui uma conta?

                        </p>

                        <a href="#"
                           data-bs-dismiss="modal"
                           data-bs-toggle="modal"
                           data-bs-target="#modalLogin">

                            Entrar

                        </a>

                    </div>

                </form>

            </div>

        </div>

    </div>

</div>


<!--
    ================================================================
    MODAL DE LOCALIZAÇÃO KIORA
    ================================================================
-->

<div class="modal fade"
     id="modalLocalizacao"
     tabindex="-1"
     aria-labelledby="modalLocalizacaoTitulo"
     aria-hidden="true">

    <div class="modal-dialog modal-dialog-centered modal-localizacao-dialog">

        <div class="modal-content modal-localizacao-kiora">

            <!--
                ========================================================
                CABEÇALHO DO MODAL
                ========================================================
            -->

            <div class="modal-localizacao-topo">

                <!-- LOGO -->

                <div class="modal-localizacao-logo">

                    <img src="~/imagens/logo-kiora-v.png"
                         alt="Kiora Japanese Cuisine">

                </div>


                <!-- BOTÃO FECHAR -->

                <button type="button"
                        class="modal-localizacao-fechar"
                        data-bs-dismiss="modal"
                        aria-label="Fechar">

                    <i class="bi bi-x-lg"></i>

                </button>

            </div>


            <!--
                ========================================================
                CONTEÚDO DO MODAL
                ========================================================
            -->

            <div class="modal-body modal-localizacao-body">

                <!--
                    ====================================================
                    CABEÇALHO INSTITUCIONAL
                    ====================================================
                -->

                <div class="modal-localizacao-header">

                    <span class="modal-localizacao-subtitulo">

                        KIORA RAMEN HOUSE

                    </span>

                    <h2 id="modalLocalizacaoTitulo">

                        Onde estamos

                    </h2>

                    <p>

                        Venha viver uma experiência além do sabor.

                    </p>

                </div>


                <!--
                    ====================================================
                    BLOCO DE ENDEREÇO
                    ====================================================
                -->

                <div class="modal-localizacao-endereco">

                    <!-- ÍCONE -->

                    <div class="modal-localizacao-icone">

                        <i class="bi bi-geo-alt-fill"></i>

                    </div>


                    <!-- INFORMAÇÕES -->

                    <div class="modal-localizacao-info">

                        <span class="modal-localizacao-label">

                            NOSSO ENDEREÇO

                        </span>

                        <h3>

                            R. dos Pinheiros, 1234

                        </h3>

                        <p>

                            Pinheiros, São Paulo - SP

                        </p>

                        <span class="modal-localizacao-cep">

                            01445-000

                        </span>

                    </div>

                </div>


                <!--
                    ====================================================
                    MAPA
                    ====================================================
                -->

                <div class="modal-localizacao-mapa">

                    <iframe
                        src="https://www.google.com/maps?q=Rua+dos+Pinheiros,+1234,+Pinheiros,+São+Paulo,+SP&output=embed"
                        title="Mapa com a localização da KIORA"
                        loading="lazy"
                        allowfullscreen
                        referrerpolicy="no-referrer-when-downgrade">
                    </iframe>

                </div>


                <!--
                    ====================================================
                    BOTÃO COMO CHEGAR
                    ====================================================
                -->

                <div class="modal-localizacao-acoes">

                    <a href="https://www.google.com/maps/search/?api=1&query=Rua+dos+Pinheiros,+1234,+Pinheiros,+São+Paulo,+SP"
                       target="_blank"
                       rel="noopener noreferrer"
                       class="btn-localizacao">

                        <i class="bi bi-sign-turn-right-fill"></i>

                        <span>

                            COMO CHEGAR

                        </span>

                    </a>

                </div>

            </div>

        </div>

    </div>

</div>


