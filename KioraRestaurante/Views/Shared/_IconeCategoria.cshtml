@model string
@{
    // O nome escolhe apenas o desenho; o filtro continua usando o ID da categoria.
    var nome = Model.Trim().ToLowerInvariant();
}
<!-- SVG local: acompanha a cor do link e permanece nítido em qualquer tamanho.
     O texto ao lado já descreve a categoria para leitores de tela. -->
<svg class="categoria-icone" viewBox="0 0 24 24" fill="none" stroke="currentColor"
     stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false">
    @switch (nome)
    {
        case "todos":
            <path d="M3 3h7v7H3z M14 3h7v7h-7z M3 14h7v7H3z M14 14h7v7h-7z" />
            break;
        case "entradas":
            <!-- Guioza sobre um prato. -->
            <path d="M3 14c0-10 18-10 18 0Z M6 12l1-4 M10 11l1-5 M14 11l1-5 M18 12l1-4 M2 17q10 6 20 0" />
            break;
        case "pratos principais":
        case "lamen":
        case "lámen":
        case "ramen":
            <!-- Tigela e hashis. -->
            <path d="M3 12h18c-1 5-4 7-9 7s-8-2-9-7Z M8 21h8 M12 10l8-8 M16 10l6-6 M6 9V6 M9 9V4" />
            break;
        case "bebidas":
            <path d="M5 7h14l-2 14H7Z M13 7l2-5h5 M6 11h12" />
            break;
        case "sobremesas":
            <path d="M4 12h16v9H4Z M4 16h16 M4 12l12-7 4 7 M12 6V4" />
            <circle cx="12" cy="3" r="1.5" />
            break;
        case "kids":
        case "infantil":
            <circle cx="12" cy="12" r="9" /><path d="M8 10h.01 M16 10h.01 M8 15q4 4 8 0" />
            break;
        case "combos":
        case "combos promocionais":
            <path d="M3 8h18v5H3Z M5 13v8h14v-8 M12 8v13 M12 8C2 8 7 0 12 8c5-8 10 0 0 0" />
            break;
        default:
            <!-- Novas categorias recebem um ícone neutro até terem um desenho próprio. -->
            <path d="M3 3h8l10 10-8 8L3 11Z" /><circle cx="7" cy="7" r="1" />
            break;
    }
</svg>
