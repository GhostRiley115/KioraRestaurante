<!--
    ================================================================
    MODAL DE LOCALIZAÇÃO KIORA
    ================================================================
-->

<div class="modal fade"
     id="modalLocalizacao"
     tabindex="-1"
     aria-labelledby="modalLocalizacaoTitulo"
     aria-hidden="true">

    <div class="modal-dialog modal-dialog-centered modal-localizacao-dialog">

        <div class="modal-content modal-localizacao-kiora">

            <!--
                ========================================================
                CABEÇALHO DO MODAL
                ========================================================
            -->

            <div class="modal-localizacao-topo">

                <!-- LOGO -->

                <div class="modal-localizacao-logo">

                    <img src="~/imagens/logo-kiora-v.png"
                         alt="Kiora Japanese Cuisine">

                </div>


                <!-- BOTÃO FECHAR -->

                <button type="button"
                        class="modal-localizacao-fechar"
                        data-bs-dismiss="modal"
                        aria-label="Fechar">

                    <i class="bi bi-x-lg"></i>

                </button>

            </div>


            <!--
                ========================================================
                CONTEÚDO DO MODAL
                ========================================================
            -->

            <div class="modal-body modal-localizacao-body">

                <!--
                    ====================================================
                    CABEÇALHO INSTITUCIONAL
                    ====================================================
                -->

                <div class="modal-localizacao-header">

                    <span class="modal-localizacao-subtitulo">

                        KIORA RAMEN HOUSE

                    </span>

                    <h2 id="modalLocalizacaoTitulo">

                        Onde estamos

                    </h2>

                    <p>

                        Venha viver uma experiência além do sabor.

                    </p>

                </div>


                <!--
                    ====================================================
                    BLOCO DE ENDEREÇO
                    ====================================================
                -->

                <div class="modal-localizacao-endereco">

                    <!-- ÍCONE -->

                    <div class="modal-localizacao-icone">

                        <i class="bi bi-geo-alt-fill"></i>

                    </div>


                    <!-- INFORMAÇÕES -->

                    <div class="modal-localizacao-info">

                        <span class="modal-localizacao-label">

                            NOSSO ENDEREÇO

                        </span>

                        <h3>

                            R. dos Pinheiros, 1234

                        </h3>

                        <p>

                            Pinheiros, São Paulo - SP

                        </p>

                        <span class="modal-localizacao-cep">

                            01445-000

                        </span>

                    </div>

                </div>


                <!--
                    ====================================================
                    MAPA
                    ====================================================
                -->

                <div class="modal-localizacao-mapa">

                    <iframe
                        src="https://www.google.com/maps?q=Rua+dos+Pinheiros,+1234,+Pinheiros,+São+Paulo,+SP&output=embed"
                        title="Mapa com a localização da KIORA"
                        loading="lazy"
                        allowfullscreen
                        referrerpolicy="no-referrer-when-downgrade">
                    </iframe>

                </div>


                <!--
                    ====================================================
                    BOTÃO COMO CHEGAR
                    ====================================================
                -->

                <div class="modal-localizacao-acoes">

                    <a href="https://www.google.com/maps/search/?api=1&query=Rua+dos+Pinheiros,+1234,+Pinheiros,+São+Paulo,+SP"
                       target="_blank"
                       rel="noopener noreferrer"
                       class="btn-localizacao">

                        <i class="bi bi-sign-turn-right-fill"></i>

                        <span>

                            COMO CHEGAR

                        </span>

                    </a>

                </div>

            </div>

        </div>

    </div>

</div>

