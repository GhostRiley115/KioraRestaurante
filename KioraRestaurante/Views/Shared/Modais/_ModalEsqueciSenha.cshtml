<!-- ================================================================ MODAL DE RECUPERAÇÃO DE SENHA KIORA ================================================================ -->

<div class="modal fade" id="modalEsqueciSenha" tabindex="-1" aria-labelledby="modalEsqueciSenhaTitulo" aria-hidden="true">

<div class="modal-dialog modal-dialog-centered modal-login-dialog">

    <div class="modal-content modal-login-kiora">

        <!--
            ====================================================
            BOTÃO FECHAR
            ====================================================
        -->

        <button type="button"
                class="btn-close modal-login-fechar"
                data-bs-dismiss="modal"
                aria-label="Fechar">

            <i class="bi bi-x-lg"></i>

        </button>


        <!--
            ====================================================
            CONTEÚDO
            ====================================================
        -->

        <div class="modal-body modal-login-body">

            <!--
                =================================================
                LOGO
                =================================================
            -->

            <div class="modal-login-logo">

                <img src="~/imagens/logo-kiora-v.png"
                     alt="Kiora Japanese Cuisine">

            </div>


            <!--
                =================================================
                ETAPA 1 - E-MAIL
                =================================================
            -->

            <div id="etapaEmailRecuperacao">

                <div class="modal-login-header">

                    <span class="modal-login-subtitulo">

                        RECUPERAÇÃO DE SENHA

                    </span>

                    <h2 id="modalEsqueciSenhaTitulo">

                        Recupere sua senha

                    </h2>

                    <p>

                        Informe seu e-mail para receber um
                        código de recuperação de senha.

                    </p>

                </div>


                <!--
                    =================================================
                    FORMULÁRIO DO E-MAIL
                    =================================================
                -->

                <form id="formEsqueciSenha"
                      asp-controller="Conta"
                      asp-action="EsqueciSenha"
                      method="post"
                      asp-antiforgery="false">

                    @Html.AntiForgeryToken()


                    <!--
                    =================================================
                    MENSAGEM
                    =================================================

                    Esta área começa escondida.

                    O JavaScript será responsável por exibir
                    mensagens de sucesso ou erro.
                    -->

                    <div id="mensagemEsqueciSenha"
                         class="mensagem-kiora"
                         role="alert"
                         style="display: none;">

                    </div>


                    <!--
                    =================================================
                    E-MAIL
                    =================================================
                    -->

                    <div class="modal-login-grupo">

                        <label for="esqueciSenhaEmail">

                            E-mail

                        </label>

                        <div class="modal-login-input">

                            <i class="bi bi-envelope"></i>

                            <input type="email"
                                   id="esqueciSenhaEmail"
                                   name="Email"
                                   placeholder="Digite seu e-mail"
                                   autocomplete="email"
                                   required>

                        </div>

                    </div>


                    <!--
                    =================================================
                    BOTÃO ENVIAR
                    =================================================
                    -->

                    <button type="submit"
                            class="btn-modal-login">

                        ENVIAR CÓDIGO

                    </button>


                    <!--
                    =================================================
                    VOLTAR PARA LOGIN
                    =================================================
                    -->

                    <div class="modal-login-cadastro">

                        <p>

                            Lembrou sua senha?

                        </p>

                        <a href="#"
                           data-bs-dismiss="modal"
                           data-bs-toggle="modal"
                           data-bs-target="#modalLogin">

                            Voltar para o login

                        </a>

                    </div>

                </form>

            </div>


            <!--
            =================================================
            ETAPA 2 - VALIDAÇÃO DO CÓDIGO
            =================================================

            Esta etapa ficará escondida inicialmente.

            O JavaScript irá exibi-la depois que o
            código for enviado para o e-mail.
            -->

            <div id="etapaCodigoRecuperacao"
                 style="display: none;">

                <div class="modal-login-header">

                    <span class="modal-login-subtitulo">

                        CONFIRMAÇÃO

                    </span>

                    <h2>

                        Digite o código

                    </h2>

                    <p>

                        Enviamos um código de 6 dígitos
                        para o seu e-mail.

                    </p>

                </div>


                <!--
                =================================================
                FORMULÁRIO DO CÓDIGO
                =================================================
                -->

                <form id="formValidarCodigo"
                      asp-controller="Conta"
                      asp-action="ValidarCodigoRecuperacao"
                      method="post"
                      asp-antiforgery="false">

                    @Html.AntiForgeryToken()


                    <!--
                    =================================================
                    MENSAGEM
                    =================================================
                    -->

                    <div id="mensagemValidarCodigo"
                         class="mensagem-kiora"
                         role="alert"
                         style="display: none;">

                    </div>


                    <!--
                    =================================================
                    CÓDIGO
                    =================================================
                    -->

                    <div class="modal-login-grupo">

                        <label for="codigoRecuperacao">

                            Código de recuperação

                        </label>

                        <div class="modal-login-input">

                            <i class="bi bi-shield-lock"></i>

                            <input type="text"
                                   id="codigoRecuperacao"
                                   name="Codigo"
                                   placeholder="Digite o código de 6 dígitos"
                                   maxlength="6"
                                   inputmode="numeric"
                                   autocomplete="one-time-code"
                                   required>

                        </div>

                    </div>


                    <!--
                    =================================================
                    BOTÃO VALIDAR
                    =================================================
                    -->

                    <button type="submit"
                            class="btn-modal-login">

                        VALIDAR CÓDIGO

                    </button>

                </form>

            </div>


            <!--
            =================================================
            ETAPA 3 - NOVA SENHA
            =================================================

            Esta etapa ficará escondida inicialmente.

            O JavaScript irá exibi-la somente depois que
            o código de recuperação for validado.
            -->

            <div id="etapaRedefinirSenha"
                 style="display: none;">

                <div class="modal-login-header">

                    <span class="modal-login-subtitulo">

                        NOVA SENHA

                    </span>

                    <h2>

                        Crie uma nova senha

                    </h2>

                    <p>

                        Informe sua nova senha para recuperar
                        o acesso à sua conta.

                    </p>

                </div>


                <!--
                =================================================
                FORMULÁRIO DA NOVA SENHA
                =================================================
                -->

                <form id="formRedefinirSenha"
                      asp-controller="Conta"
                      asp-action="RedefinirSenha"
                      method="post"
                      asp-antiforgery="false">

                    @Html.AntiForgeryToken()


                    <!--
                    =================================================
                    MENSAGEM
                    =================================================
                    -->

                    <div id="mensagemRedefinirSenha"
                         class="mensagem-kiora"
                         role="alert"
                         style="display: none;">

                    </div>


                    <!--
                    =================================================
                    CÓDIGO DE RECUPERAÇÃO
                    =================================================

                    Este campo permanece oculto para o usuário.

                    O JavaScript irá copiar para ele o código
                    que foi validado na etapa anterior.

                    Assim, o Controller receberá o código junto
                    com a nova senha.
                    -->

                    <input type="hidden"
                           id="codigoRedefinicao"
                           name="Codigo">


                    <!--
                    =================================================
                    NOVA SENHA
                    =================================================
                    -->

                    <div class="modal-login-grupo">

                        <label for="novaSenhaRecuperacao">

                            Nova senha

                        </label>

                        <div class="modal-login-input">

                            <i class="bi bi-lock"></i>

                            <input type="password"
                                   id="novaSenhaRecuperacao"
                                   name="NovaSenha"
                                   placeholder="Digite sua nova senha"
                                   autocomplete="new-password"
                                   required>

                        </div>

                    </div>


                    <!--
                    =================================================
                    CONFIRMAR NOVA SENHA
                    =================================================
                    -->

                    <div class="modal-login-grupo">

                        <label for="confirmarNovaSenhaRecuperacao">

                            Confirmar nova senha

                        </label>

                        <div class="modal-login-input">

                            <i class="bi bi-lock-fill"></i>

                            <input type="password"
                                   id="confirmarNovaSenhaRecuperacao"
                                   name="ConfirmarNovaSenha"
                                   placeholder="Confirme sua nova senha"
                                   autocomplete="new-password"
                                   required>

                        </div>

                    </div>


                    <!--
                    =================================================
                    BOTÃO REDEFINIR
                    =================================================
                    -->

                    <button type="submit"
                            class="btn-modal-login">

                        REDEFINIR SENHA

                    </button>

                </form>

            </div>

        </div>

    </div>

</div>

</div>