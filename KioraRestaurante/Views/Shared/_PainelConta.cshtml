<!--
                        =================================================
                        MENU DO USUÁRIO
                        =================================================
                    -->
<!-- PAINEL DA CONTA: opções para visitante, cliente e administrador. -->
<aside class="offcanvas offcanvas-end painel-conta" tabindex="-1" id="painelConta" aria-labelledby="tituloPainelConta">
    <div class="offcanvas-header">
        <h2 class="offcanvas-title" id="tituloPainelConta">Sua conta</h2>
        <button type="button" class="btn-close btn-close-white" data-bs-dismiss="offcanvas" aria-label="Fechar conta"></button>
    </div>
    <div class="offcanvas-body">
        <!-- Preferência disponível para visitante, cliente e administrador. -->
        <div class="tema-controle">
            <label for="preferenciaTema"><i class="bi bi-circle-half" aria-hidden="true"></i> Aparência</label>
            <select id="preferenciaTema" data-seletor-tema>
                <option value="sistema">Seguir o sistema</option>
                <option value="claro">Claro</option>
                <option value="escuro">Escuro</option>
            </select>
        </div>
        <!-- Os links abaixo preservam as ações e permissões já existentes. -->
                        <!-- MENU DO USUÁRIO -->

                        <ul class="conta-opcoes"
                        aria-label="Opções da conta">

                        @if (User.Identity != null && User.Identity.IsAuthenticated)
                        {
                            <!-- =====================================================
                                 USUÁRIO AUTENTICADO
                                 ===================================================== -->

                            <li>

                                <span class="dropdown-item-text usuario-logado">

                                    <i class="bi bi-person-circle" aria-hidden="true"></i>

                                    Olá, @User.Identity.Name!

                                </span>

                            </li>

                            <li>

                                <hr class="dropdown-divider">

                            </li>

                            <li>
                                <a class="conta-opcao"
                                   asp-controller="Pedido"
                                   asp-action="MeusPedidos">
                                    <i class="bi bi-receipt" aria-hidden="true"></i>
                                    Meus pedidos
                                </a>
                            </li>


                            <!-- ADMINISTRAÇÃO: somente administradores veem esta opção. -->
                            @if (User.IsInRole("Administrador"))
                            {
                                <!-- Central administrativa: pedidos, usuários e atalhos. -->
                                <li><a class="conta-opcao" asp-controller="Admin" asp-action="Index">
                                    <i class="bi bi-speedometer2" aria-hidden="true"></i>Administração
                                </a></li>
                                <li>
                                    <a class="conta-opcao" asp-controller="ProdutosAdmin" asp-action="Cadastrar">
                                        <i class="bi bi-plus-circle" aria-hidden="true"></i>
                                        Cadastrar produto
                                    </a>
                                </li>
                            }

                            <li><a class="conta-opcao" asp-controller="Reservas" asp-action="Minhas"><i class="bi bi-calendar-check" aria-hidden="true"></i>Minhas reservas</a></li>

                            <!-- MEU PERFIL -->

                            <li>

                                <a class="conta-opcao"
                                   asp-controller="Conta"
                                   asp-action="MeuPerfil">

                                    <i class="bi bi-person" aria-hidden="true"></i>

                                    Meu perfil

                                </a>

                            </li>

                            <!-- MEUS ENDEREÇOS: opção exibida somente para clientes. -->
                            @if (User.IsInRole("Cliente"))
                                {
                                    <li>
                                        <a class="conta-opcao"
                                           asp-controller="Enderecos"
                                           asp-action="Index">
                                            <i class="bi bi-geo-alt" aria-hidden="true"></i>
                                            Meus endereços
                                        </a>
                                    </li>
                                }


                                <!-- DIVISOR -->

                            <li>

                                <hr class="dropdown-divider">

                            </li>

                            <!-- SAIR -->
                            <li>
                                <form asp-controller="Conta"
                                      asp-action="Logout"
                                      method="post">
                                    <button type="submit" class="conta-opcao">
                                        Sair
                                    </button>
                                </form>
                            </li>
                        }
                        else
                        {
                            <!-- =====================================================
                                 USUÁRIO NÃO AUTENTICADO
                                 ===================================================== -->

                            <!-- ENTRAR -->

                            <li>

                                <a class="conta-opcao"
                                   href="#"
                                   data-conta-modal
                                   data-conta-destino="#modalLogin">

                                    <i class="bi bi-box-arrow-in-right" aria-hidden="true"></i>

                                    Entrar

                                </a>

                            </li>


                            <!-- CRIAR CONTA -->

                            <li>

                                <a class="conta-opcao"
                                   href="#"
                                   data-conta-modal
                                   data-conta-destino="#modalCadastro">

                                    <i class="bi bi-person-plus" aria-hidden="true"></i>

                                    Criar conta

                                </a>

                            </li>
                        }

                    </ul>
    </div>
</aside>
