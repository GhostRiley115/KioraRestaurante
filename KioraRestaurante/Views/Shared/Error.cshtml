@model KioraRestaurante.Models.ErrorViewModel
@{ ViewData["Title"] = "Não foi possível concluir"; }
@section Styles { <link rel="stylesheet" href="~/css/estados.css" asp-append-version="true" /> }
<section class="container pagina-estado" aria-labelledby="tituloErro">
    <div class="pagina-estado-card">
        <i class="bi bi-exclamation-circle pagina-estado-icone" aria-hidden="true"></i>
        <span class="pedido-sobretitulo">KIORA · ATENDIMENTO</span>
        <h1 id="tituloErro">Não foi possível concluir esta ação.</h1>
        <p>Tente novamente em instantes. Se estava finalizando uma compra, confira seus pedidos antes de repetir.</p>
        <div class="pagina-estado-acoes">
            @if (User.IsInRole("Cliente")) { <a asp-controller="Pedido" asp-action="MeusPedidos" class="pedido-botao">Ver meus pedidos</a> }
            else if (User.IsInRole("Administrador")) { <a asp-controller="Admin" asp-action="Pedidos" class="pedido-botao">Ver pedidos</a> }
            <a asp-controller="Home" asp-action="Index" class="pedido-link">Voltar ao início</a>
        </div>
        @if (Model.ShowRequestId) { <p class="pagina-estado-codigo">Código para informar ao suporte: <code>@Model.RequestId</code></p> }
    </div>
</section>
