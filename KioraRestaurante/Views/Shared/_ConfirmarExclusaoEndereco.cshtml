<dialog id="confirmarExclusaoEndereco" class="pedido-dialogo" aria-labelledby="tituloExcluirEndereco" aria-describedby="textoExcluirEndereco">
    <h2 id="tituloExcluirEndereco">Excluir endereço?</h2>
    <p id="textoExcluirEndereco">O endereço será removido da sua lista. Pedidos já feitos serão mantidos.</p>
    <p id="nomeExcluirEndereco" class="pedido-texto-suave"></p>
    <div class="d-flex gap-3 flex-wrap">
        <button type="button" id="cancelarExclusaoEndereco" class="pedido-botao pedido-botao-secundario" autofocus>Manter endereço</button>
        <button type="button" id="executarExclusaoEndereco" class="pedido-botao">Excluir endereço</button>
    </div>
</dialog>
<p id="mensagemExclusaoEndereco" role="status" aria-live="polite" class="pedido-texto-suave mt-3"></p>
