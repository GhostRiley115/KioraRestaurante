@model KioraRestaurante.Models.Pedido
@using KioraRestaurante.Models.Enums
@{ ViewData["Title"] = "Pagamento"; }
<section class="container pedido-pagina">
    <h1>Pagamento do pedido #@Model.Id</h1>
    <p>Total: @Model.ValorTotal.ToString("C", System.Globalization.CultureInfo.GetCultureInfo("pt-BR"))</p>
    <p>Status: <strong>@Model.StatusPagamento</strong></p>
    @if (TempData["PagamentoAviso"] is string aviso)
    {
        <p role="alert">@aviso</p>
    }
    @if (Model.StatusPagamento == StatusPagamento.Pendente && Model.StatusPedido != StatusPedido.Cancelado)
    {
        <form asp-action="Pagar" method="post">
            <input type="hidden" name="id" value="@Model.Id" />
            <button type="submit" class="btn btn-primary">Pagar com Mercado Pago</button>
        </form>
    }
    <form asp-action="Consultar" method="post" class="mt-3">
        <input type="hidden" name="id" value="@Model.Id" />
        <button type="submit" class="btn btn-outline-secondary">Atualizar pagamento</button>
    </form>
    <a asp-controller="Pedido" asp-action="Detalhes" asp-route-id="@Model.Id">Ver detalhes do pedido</a>
</section>