@model KioraRestaurante.DTOs.Usuario.UsuarioResponseDTO

<!-- ================================================================
     MODAL EDITAR PERFIL
     ================================================================ -->

<!--
    Modal utilizado para permitir que o usuário
    altere seus dados pessoais.

    Neste momento serão permitidos somente:
    - Alteração do nome.
    - Alteração do e-mail.

    A senha continuará sendo tratada separadamente.
-->

<div class="modal fade"
     id="modalEditarPerfil"
     tabindex="-1"
     aria-labelledby="modalEditarPerfilTitulo"
     aria-hidden="true">

<!-- ============================================================
     CONTAINER DO MODAL
     ============================================================ -->

<!--
    Centraliza o modal verticalmente na tela.
-->
<div class="modal-dialog modal-dialog-centered modal-editar-perfil-dialog">


    <!-- ========================================================
         CONTEÚDO DO MODAL
         ======================================================== -->

    <div class="modal-content modal-editar-perfil">


        <!-- ====================================================
             CABEÇALHO DO MODAL
             ==================================================== -->

        <div class="modal-header modal-editar-perfil-header">


            <!-- =================================================
                 TÍTULO
                 ================================================= -->

            <!--
                Título apresentado na parte superior
                do modal.
            -->
            <h5 class="modal-title"
                id="modalEditarPerfilTitulo">

                Editar Perfil

            </h5>


            <!-- =================================================
                 BOTÃO FECHAR
                 ================================================= -->

            <!--
                Botão utilizado para fechar o modal.

                O Bootstrap identifica que este botão
                deve fechar o modal através do atributo
                data-bs-dismiss.
            -->
            <button type="button"
                    class="btn-close"
                    data-bs-dismiss="modal"
                    aria-label="Fechar">
            </button>


        </div>
        <!-- Fim do cabeçalho do modal. -->


        <!-- ====================================================
             CORPO DO MODAL
             ==================================================== -->

        <div class="modal-body modal-editar-perfil-body">


            <!-- =================================================
                 MENSAGEM
                 ================================================= -->

            <!--
                Área reservada para as mensagens de sucesso
                ou erro que serão exibidas pelo JavaScript.

                Inicialmente ela fica vazia.
            -->
            <div id="mensagemEditarPerfil"
                 class="mensagem-editar-perfil"
                 role="alert">
            </div>


            <!-- =================================================
                 FORMULÁRIO
                 ================================================= -->

            <!--
                Formulário responsável por enviar
                os dados atualizados do usuário.

                O JavaScript utilizará este ID
                para identificar o formulário.
            -->
            <form id="formEditarPerfil" asp-controller="Conta" asp-action="EditarPerfil"
                  method="post" asp-antiforgery="false">
                @Html.AntiForgeryToken()

                <!-- =============================================
                     NOME
                     ============================================= -->

                <!-- Identificação do campo nome. -->
                <div class="mb-3">

                    <label for="editarPerfilNome"
                           class="form-label">

                        Nome

                    </label>


                    <!--
                        Campo que receberá o nome atual
                        do usuário.

                        O valor será preenchido pelo
                        JavaScript posteriormente.
                    -->
                    <input type="text"
                           class="form-control"
                           id="editarPerfilNome"
                           name="Nome"
                           value="@Model.Nome"
                           required />

                </div>


                <!-- =============================================
                     E-MAIL
                     ============================================= -->

                <!-- Identificação do campo e-mail. -->
                <div class="mb-3">

                    <label for="editarPerfilEmail"
                           class="form-label">

                        E-mail

                    </label>


                    <!--
                        Campo que receberá o e-mail atual
                        do usuário.
                    -->
                    <input type="email"
                           class="form-control"
                           id="editarPerfilEmail"
                           name="Email"
                           value="@Model.Email"
                           required />

                </div>


                <!-- =============================================
                     BOTÃO SALVAR
                     ============================================= -->

                <!--
                    Botão responsável por enviar
                    as alterações realizadas no formulário.
                -->
                <button type="submit"
                        class="btn-salvar-perfil-kiora">

                    Salvar alterações

                </button>


            </form>
            <!-- Fim do formulário. -->


        </div>
        <!-- Fim do corpo do modal. -->


    </div>
    <!-- Fim do conteúdo do modal. -->


</div>
<!-- Fim do container do modal. -->

</div>
<!-- Fim do modal Editar Perfil. -->

