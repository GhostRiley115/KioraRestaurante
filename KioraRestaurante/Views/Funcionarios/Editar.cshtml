@model KioraRestaurante.DTOs.Salao.SalvarFuncionarioDTO
@{ViewData["Title"]=Model.Id.HasValue?"Editar funcionário":"Cadastrar funcionário";}
<a asp-action="Index">← Funcionários</a><h1>@ViewData["Title"]</h1><p class="admin-suave">Dados da conta, função no restaurante e situação de acesso.</p>
<form method="post" class="equipe-box equipe-form"><div asp-validation-summary="All" class="pedido-erros" role="alert"></div><input asp-for="Id" type="hidden"/><input asp-for="Versao" type="hidden"/>
<label asp-for="Nome">Nome</label><input asp-for="Nome" maxlength="100" required/><label asp-for="Email">E-mail individual</label><input asp-for="Email" type="email" maxlength="150" required/><label asp-for="Telefone">Telefone (opcional)</label><input asp-for="Telefone" type="tel" maxlength="25"/>
<fieldset class="equipe-grupo-form"><legend>Função e acesso</legend><label asp-for="Cargo">Cargo do funcionário</label><select asp-for="Cargo"><option value="3">Garçom</option><option value="4">Recepção</option><option value="5">Cozinha</option>@if(User.IsInRole("Administrador")){<option value="2">Gerente</option>}</select>
<label><input asp-for="Ativo"/> Acesso ativo</label></fieldset><p class="admin-suave">Alterar cargo ou desativar encerra as sessões anteriores. Mesas sob responsabilidade do funcionário precisam ser transferidas antes.</p><p class="admin-suave">Ao criar a conta ou mudar o e-mail, um convite será enviado para o funcionário definir sua própria senha.</p><button type="submit">Salvar funcionário</button></form>
