@model List<KioraRestaurante.DTOs.Salao.FuncionarioDTO>
@using KioraRestaurante.Services.Salao
@{ViewData["Title"]="Equipe e permissões";var admin=User.IsInRole("Administrador");}
<header class="admin-cabecalho"><div><span class="admin-sobretitulo">PESSOAS DO RESTAURANTE</span><h1>Equipe e permissões</h1><p class="admin-suave">Cada funcionário tem sua conta e acesso conforme o cargo.</p></div><a asp-action="Editar" class="admin-botao">Cadastrar funcionário</a></header>
<div class="equipe-indicadores"><p><span>Acessos ativos</span><strong>@Model.Count(f=>f.Ativo&&!f.AguardandoConvite)</strong></p><p><span>Aguardando senha</span><strong>@Model.Count(f=>f.Ativo&&f.AguardandoConvite)</strong></p><p><span>Desativados</span><strong>@Model.Count(f=>!f.Ativo)</strong></p></div>
<div class="equipe-ferramentas"><label for="buscarEquipe">Buscar por nome, e-mail ou cargo</label><input id="buscarEquipe" type="search" class="equipe-busca" data-buscar-equipe placeholder="Ex.: Ana, cozinha ou recepção"/></div>
<div class="equipe-funcionarios">@foreach(var f in Model){var podeEditar=admin||f.Cargo!=KioraRestaurante.Models.Enums.TipoUsuario.Gerente;<article class="equipe-box" data-funcionario data-busca="@f.Nome @f.Email @TextosSalao.Cargo(f.Cargo)"><div class="equipe-card-topo"><span class="equipe-status @(!f.Ativo?"estado-inativa":f.AguardandoConvite?"estado-chamada":"estado-livre")">@(!f.Ativo?"Acesso desativado":f.AguardandoConvite?"Aguardando senha":"Acesso ativo")</span><span class="equipe-origem">@TextosSalao.Cargo(f.Cargo)</span></div><h2>@f.Nome</h2><p class="equipe-email">@f.Email</p><p class="admin-suave">@(string.IsNullOrWhiteSpace(f.Telefone)?"Telefone não informado":f.Telefone)</p>
@if(podeEditar){<div class="admin-acoes"><a asp-action="Editar" asp-route-id="@f.Id" class="admin-botao admin-botao-secundario">Editar acesso e cargo</a>@if(f.Ativo&&f.AguardandoConvite){<form asp-action="Reenviar" method="post"><input type="hidden" name="funcionarioId" value="@f.Id"/><input type="hidden" name="versao" value="@f.Versao"/><button type="submit">Reenviar convite</button></form>}</div>}else{<p class="admin-suave">O administrador gerencia este acesso.</p>}</article>}</div>
<p data-equipe-vazia class="admin-vazio" hidden role="status">Nenhum funcionário corresponde à busca.</p>
<details class="equipe-box"><summary>O que cada cargo pode fazer?</summary><dl class="equipe-permissoes"><div><dt>Garçom</dt><dd>Acomoda grupos, lança e acompanha os itens das suas mesas, registra o fechamento e libera após limpeza.</dd></div><div><dt>Recepção</dt><dd>Registra chegadas, organiza a fila e chama grupos para mesas disponíveis.</dd></div><div><dt>Cozinha</dt><dd>Consulta a fila e marca início do preparo e pratos prontos.</dd></div><div><dt>Gerente</dt><dd>Gerencia o salão, corrige pedidos, concede descontos, acompanha vendas físicas e os acessos operacionais da equipe.</dd></div><div><dt>Administrador</dt><dd>Acesso completo ao gerenciamento, incluindo delivery, produtos, cupons e relatórios gerais.</dd></div></dl></details>
