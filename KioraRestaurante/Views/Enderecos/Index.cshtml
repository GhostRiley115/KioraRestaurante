@model List<KioraRestaurante.Models.EnderecoUsuario>

@{
    ViewData["Title"] = "Meus endereços";
}

<section class="container pedido-pagina">
    <h1>Meus endereços</h1>

    @if (TempData["EnderecoSucesso"] is string mensagem)
    {
        <p role="status">@mensagem</p>
    }

    <div class="d-flex gap-3 flex-wrap mb-4">
        <a asp-action="Novo" class="pedido-link">Cadastrar endereço</a>
        <a asp-controller="Pedido"
           asp-action="Checkout"
           class="pedido-link">Voltar ao checkout</a>
    </div>

    @if (Model.Count == 0)
    {
        <p>Você ainda não cadastrou endereços.</p>
    }

    <div class="row g-3">
        @foreach (var endereco in Model)
        {
            <div class="col-12 col-md-6">
                <article class="pedido-box">
                    <h2>@endereco.Apelido</h2>

                    <p>
                        @endereco.Logradouro, @endereco.Numero<br />
                        @endereco.Bairro — @endereco.Cidade/@endereco.Uf<br />
                        CEP @endereco.Cep
                    </p>

                    @if (!string.IsNullOrWhiteSpace(endereco.Complemento))
                    {
                        <p>@endereco.Complemento</p>
                    }

                    <a asp-action="Editar"
                       asp-route-id="@endereco.Id"
                       class="pedido-link">Editar endereço</a>
                </article>
            </div>
        }
    </div>
</section>