@model List<KioraRestaurante.Models.EnderecoUsuario>

@{
    ViewData["Title"] = "Meus endereços";
}

<section class="container pedido-pagina">
    <h1>Meus endereços</h1>

    @if (TempData["EnderecoSucesso"] is string mensagem)
    {
        <p role="status">@mensagem</p>
    }

    @if (TempData["EnderecoErro"] is string erro) { <p class="pedido-erros" role="alert">@erro</p> }

    <div class="d-flex gap-3 flex-wrap mb-4">
        <a asp-action="Novo" class="pedido-link">Cadastrar endereço</a>
    </div>

    <p id="enderecosVazios" hidden="@(Model.Count > 0)">Você ainda não cadastrou endereços. Também pode informar um endereço diretamente no checkout, sem salvar na conta.</p>

    <div class="row g-3">
        @foreach (var endereco in Model)
        {
            <div class="col-12 col-md-6" data-endereco-cartao>
                <article class="pedido-box">
                    <h2>@endereco.Apelido</h2>

                    <p>
                        @endereco.Logradouro, @endereco.Numero<br />
                        @endereco.Bairro — @endereco.Cidade/@endereco.Uf<br />
                        CEP @endereco.Cep
                    </p>

                    @if (!string.IsNullOrWhiteSpace(endereco.Complemento))
                    {
                        <p>@endereco.Complemento</p>
                    }

                    <a asp-action="Editar"
                       asp-route-id="@endereco.Id"
                       class="pedido-link">Editar endereço</a>
                    <form asp-action="Excluir" method="post" class="d-inline">
                        <input type="hidden" name="id" value="@endereco.Id" />
                        <input type="hidden" name="versao" value="@endereco.Versao" />
                        <button type="submit" class="pedido-link pedido-link-excluir" data-excluir-endereco
                                data-endereco-id="@endereco.Id" data-endereco-versao-exclusao="@endereco.Versao"
                                data-endereco-nome="@endereco.Apelido" data-exclusao-url="@Url.Action("Excluir")">Excluir endereço</button>
                    </form>
                </article>
            </div>
        }
    </div>
</section>
<partial name="_ConfirmarExclusaoEndereco" />
@section Scripts {
    <script src="~/js/endereco-exclusao.js" asp-append-version="true"></script>
}
