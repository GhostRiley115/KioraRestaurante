@model KioraRestaurante.ViewModels.CheckoutViewModel
@using System.Globalization

@{
    ViewData["Title"] = "Revisar pedido";

    var cultura = CultureInfo.GetCultureInfo("pt-BR");

    var podeConfirmar =
        Model.Resumo.PodeProsseguir
        && !string.IsNullOrWhiteSpace(Model.Dados.TokenRevisao)
        && Model.Entrega != null;
}

<section class="container pedido-pagina">
    <span class="pedido-sobretitulo">KIORA · CHECKOUT</span>
    <h1>Revise seu pedido</h1>

    <p class="pedido-texto-suave">
        Confira os produtos, informe o endereço e escolha
        como deseja pagar.
    </p>

    <div asp-validation-summary="All"
         class="pedido-erros"
         role="alert"></div>

    @if (Model.Resumo.Avisos.Count > 0)
    {
        <ul class="pedido-erros">
            @foreach (var aviso in Model.Resumo.Avisos)
            {
                <li>@aviso</li>
            }
        </ul>
    }

    <form asp-controller="Pedido"
          asp-action="Checkout"
          method="post"
          id="formCheckout"
          data-endereco-form data-endereco-prefixo="Dados_NovoEndereco_"
          data-cep-base="@Url.Content("~/api/cep/")"
          data-cotacao-url="@Url.Action("CotarEntrega", "Pedido")"
          data-total-produtos="@Model.Resumo.Total.ToString(CultureInfo.InvariantCulture)"
          data-pode-prosseguir="@(Model.Resumo.PodeProsseguir && !string.IsNullOrWhiteSpace(Model.Dados.TokenRevisao) ? "true" : "false")"
          data-validade-entrega="@Model.Entrega?.ExpiraEmUtc.ToString("O")">

        <input asp-for="Dados.TokenRevisao" type="hidden" />
        <input asp-for="Dados.TokenEntrega" type="hidden" />

        <div class="row g-4">
            <div class="col-12 col-lg-7">
                <partial name="~/Views/Pedido/_EnderecoCheckout.cshtml" model="Model" />

                <section class="pedido-box mt-4">
                    <span class="pedido-etapa">2 · PAGAMENTO</span>
                    <h2>Forma de pagamento</h2>

                    <label asp-for="Dados.FormaPagamento">
                        Como deseja pagar?
                    </label>

                    <select asp-for="Dados.FormaPagamento"
                            class="form-select">
                        <option value="">Selecione</option>
                        <option value="0">Dinheiro</option>
                        <option value="4">Mercado Pago — pagamento online</option>
                    </select>

                    <p class="pedido-texto-suave mt-3 mb-0">
                        Escolha Mercado Pago para pagar online ou dinheiro para pagar na entrega.
                    </p>
                </section>
            </div>

            <div class="col-12 col-lg-5">
                <section class="pedido-box checkout-resumo">
                    <span class="pedido-etapa">3 · RESUMO</span>
                    <h2>Seu pedido</h2>

                    @if (Model.Resumo.Itens.Count == 0)
                    {
                        <p>Seu carrinho está vazio.</p>
                    }

                    @foreach (var item in Model.Resumo.Itens)
                    {
                        <div class="pedido-linha">
                            <div>
                                <strong>@item.NomeProduto</strong>

                                @if (!string.IsNullOrWhiteSpace(item.Composicao))
                                {
                                    <p class="pedido-texto-suave mb-0">
                                        Composição por combo: @item.Composicao
                                    </p>
                                }

                                <p class="pedido-texto-suave mb-0">
                                    @item.Quantidade ×
                                    @item.PrecoUnitario.ToString("C", cultura)
                                </p>

                                @if (item.Aviso != null)
                                {
                                    <p class="pedido-erros">
                                        @item.Aviso
                                    </p>
                                }
                            </div>

                            <strong>
                                @item.Subtotal.ToString("C", cultura)
                            </strong>
                        </div>
                    }

                    <dl class="checkout-resumo-valores">
                        <div><dt>Subtotal dos produtos</dt><dd>@Model.Resumo.Total.ToString("C", cultura)</dd></div>
                        <div><dt>Distância pelas ruas</dt><dd id="distanciaEntrega">@(Model.Entrega == null ? "A calcular" : (Model.Entrega.DistanciaMetros / 1000m).ToString("0.00", cultura) + " km")</dd></div>
                        <div><dt>Taxa de entrega</dt><dd id="taxaEntrega">@(Model.Entrega == null ? "A calcular" : Model.Entrega.Taxa.ToString("C", cultura))</dd></div>
                        <div class="pedido-total"><dt>Total do pedido</dt><dd id="totalComEntrega">@(Model.Entrega == null ? "A calcular" : (Model.Resumo.Total + Model.Entrega.Taxa).ToString("C", cultura))</dd></div>
                    </dl>

                    <button type="submit"
                            id="confirmarPedido"
                            class="pedido-botao"
                            disabled="@(!podeConfirmar)">
                        Confirmar pedido
                    </button>

                    <p class="pedido-texto-suave mt-3">
                        Se alterar o carrinho, atualize esta revisão
                        antes de confirmar.
                    </p>

                    <a asp-action="Checkout" class="pedido-link">
                        Atualizar revisão
                    </a>

                    <button type="button"
                            class="pedido-link"
                            data-bs-toggle="offcanvas"
                            data-bs-target="#painelCarrinho"
                            aria-controls="painelCarrinho">
                        Abrir carrinho
                    </button>
                </section>
            </div>
        </div>
    </form>
</section>

<partial name="_ConfirmarExclusaoEndereco" />

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script src="~/js/Endereco.js" asp-append-version="true"></script>
    <script src="~/js/endereco-exclusao.js" asp-append-version="true"></script>
    <script src="~/js/checkout.js" asp-append-version="true"></script>
}
