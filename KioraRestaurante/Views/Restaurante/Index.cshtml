@model PainelSalaoViewModel
@{ViewData["Title"]="Salão e mesas";var gestor=User.IsInRole("Administrador")||User.IsInRole("Gerente");var meuId=User.FindFirst(System.Security.Claims.ClaimTypes.NameIdentifier)?.Value;}
<header class="equipe-cabecalho"><div><h1>Salão e mesas</h1><p>Uma comanda por atendimento. A conta permanece aberta entre novas rodadas.</p></div><a asp-action="Index">Atualizar mesas</a></header>
<div class="equipe-indicadores"><p><strong>@Model.Mesas.Count(m=>m.Situacao=="Livre")</strong> livres</p><p><strong>@Model.Mesas.Count(m=>m.Situacao=="Ocupada")</strong> ocupadas</p><p><strong>@Model.Mesas.Count(m=>m.Situacao=="Aguardando limpeza")</strong> aguardando limpeza</p></div>
@if(gestor){<p><a asp-action="Configurar">Cadastrar mesa</a></p>}
<div class="equipe-mesas">
@foreach(var mesa in Model.Mesas){var propria=gestor||mesa.GarcomId?.ToString()==meuId;
<section class="equipe-box"><h2>@mesa.Nome</h2><p>@mesa.Capacidade lugares · <strong>@mesa.Situacao</strong></p>
    @if(mesa.AtendimentoId.HasValue){<p>@mesa.Pessoas pessoa(s) · Garçom: @mesa.Garcom</p>@if(propria){<a class="pedido-botao" asp-action="Comanda" asp-route-id="@mesa.AtendimentoId">Abrir comanda</a>}else{<p>Atendimento de outro garçom. Peça ao gerente para transferir, se necessário.</p>}}
    else if(mesa.Habilitada){
        <details><summary>Acomodar grupo</summary><form asp-action="Acomodar" method="post" class="equipe-form">
            <input type="hidden" name="ChaveSolicitacao" value="@Guid.NewGuid()"/><input type="hidden" name="MesaId" value="@mesa.Id"/><input type="hidden" name="Versao" value="@mesa.Versao"/>
            <label for="grupo-@mesa.Id">Grupo registrado pela portaria (opcional)</label><select id="grupo-@mesa.Id" name="ReservaCodigo"><option value="">Atendimento direto, sem reserva</option>
                @foreach(var g in Model.Grupos.Where(g=>g.ChegadaUtc!=null&&g.Pessoas<=mesa.Capacidade&&(g.MesaId==null||g.MesaId==mesa.Id))){<option value="@g.Codigo">@g.Nome · @g.Pessoas pessoa(s)</option>}</select>
            <label for="nome-@mesa.Id">Nome do grupo, se atendimento direto</label><input id="nome-@mesa.Id" name="NomeGrupo" maxlength="100"/>
            <label for="pessoas-@mesa.Id">Pessoas, se atendimento direto</label><input id="pessoas-@mesa.Id" name="Pessoas" type="number" min="1" max="@mesa.Capacidade" value="2"/>
            @if(gestor){<label for="garcom-@mesa.Id">Garçom responsável</label><select id="garcom-@mesa.Id" name="GarcomId">@foreach(var g in Model.Garcons){<option value="@g.Id" selected="@(g.Id.ToString()==meuId)">@g.Nome</option>}</select>}
            <button type="submit" class="pedido-botao">Confirmar acomodação e abrir comanda</button>
        </form></details>
    }
    @if(gestor){<p class="mt-3"><a asp-action="Configurar" asp-route-id="@mesa.Id">Configurar mesa</a></p>}
</section>}
</div>
