@model ComandaSalaoViewModel
@{var a=Model.Comanda;ViewData["Title"]=$"Comanda · {a.Mesa}";var cultura=CultureInfo.GetCultureInfo("pt-BR");var gestor=User.IsInRole("Administrador")||User.IsInRole("Gerente");var aberta=a.Situacao==SituacaoAtendimento.Aberto;}
<header class="equipe-cabecalho"><div><h1>@a.Mesa · Comanda</h1><p>@a.NomeGrupo · @a.Pessoas pessoa(s) · Garçom: @a.Garcom</p><p>Aberta às @HorarioRestaurante.ParaLocal(a.AbertoEmUtc).ToString("dd/MM HH:mm") · @KioraRestaurante.Services.Salao.TextosSalao.Atendimento(a.Situacao)</p></div><a asp-action="Comanda" asp-route-id="@a.Id">Atualizar comanda</a></header>
<div class="equipe-indicadores"><p>Produtos <strong>@a.Subtotal.ToString("C",cultura)</strong></p><p>Desconto <strong>@a.Desconto.ToString("C",cultura)</strong></p><p>Total <strong>@a.Total.ToString("C",cultura)</strong></p></div>
@if(!string.IsNullOrWhiteSpace(a.MotivoDesconto)){<p>Motivo do desconto: @a.MotivoDesconto</p>}
<div class="comanda-colunas"><section><h2>Consumo da mesa</h2>
@if(a.Itens.Count==0){<p class="equipe-box">Ainda não há itens. Adicione o primeiro produto pelo cardápio ao lado.</p>}
@foreach(var item in a.Itens){<article class="equipe-box comanda-item"><div class="pedido-item-detalhes"><img class="pedido-item-foto" src="@(string.IsNullOrWhiteSpace(item.ImagemUrl)?Url.Content("~/imagens/produto-sem-foto.svg"):item.ImagemUrl)" alt="" width="80" height="80" loading="lazy" data-foto-produto data-foto-alternativa="@Url.Content("~/imagens/produto-sem-foto.svg")"/><div><h3>@item.Quantidade × @item.Nome</h3><p>@((item.Quantidade*item.PrecoUnitario).ToString("C",cultura)) · @KioraRestaurante.Services.Salao.TextosSalao.Preparo(item.Situacao)</p></div></div>
@if(!string.IsNullOrWhiteSpace(item.Composicao)){<p>Combo: @item.Composicao</p>}
@if(!string.IsNullOrWhiteSpace(item.Observacao)){<p>Observação: @item.Observacao</p>}
@if(item.Situacao==SituacaoPreparo.Cancelado){<p>Cancelado: @item.MotivoCancelamento. Este item não compõe a conta.</p>}
@if(aberta&&item.Situacao==SituacaoPreparo.Pronto){<form asp-action="Entregar" method="post"><input type="hidden" name="AtendimentoId" value="@a.Id"/><input type="hidden" name="ItemId" value="@item.Id"/><input type="hidden" name="Versao" value="@a.Versao"/><input type="hidden" name="ChaveSolicitacao" value="@Guid.NewGuid()"/><button type="submit">Confirmar entregue à mesa</button></form>}
@if(aberta&&item.Situacao!=SituacaoPreparo.Cancelado&&(gestor||item.Situacao==SituacaoPreparo.NaFila)){
<details><summary>Corrigir ou cancelar item</summary><form asp-action="Corrigir" method="post" class="equipe-form"><input type="hidden" name="AtendimentoId" value="@a.Id"/><input type="hidden" name="ItemId" value="@item.Id"/><input type="hidden" name="Versao" value="@a.Versao"/><input type="hidden" name="ChaveSolicitacao" value="@Guid.NewGuid()"/>
<label for="produto-@item.Id">Produto correto</label><select id="produto-@item.Id" name="ProdutoId"><option value="@item.ProdutoId">Manter @item.Nome</option>@foreach(var p in Model.Produtos.Where(p=>p.Disponivel&&p.Id!=item.ProdutoId)){<option value="@p.Id">@p.Nome · @p.Preco.ToString("C",cultura)</option>}</select>
<label for="quantidade-@item.Id">Quantidade correta (zero cancela)</label><input id="quantidade-@item.Id" name="Quantidade" type="number" min="0" max="30" value="@item.Quantidade" required/>
<label for="observacao-@item.Id">Observações</label><textarea id="observacao-@item.Id" name="Observacao" maxlength="500">@item.Observacao</textarea>
<label for="motivo-@item.Id">Motivo da correção</label><input id="motivo-@item.Id" name="Motivo" maxlength="400" required/><p>O item anterior fica registrado como cancelado; uma substituição entra novamente na fila de preparo.</p><button type="submit">Confirmar correção</button></form></details>}
</article>}
</section><section>
@if(aberta){<h2>Cardápio da mesa</h2><label for="buscarProdutoSalao">Buscar produto</label><input id="buscarProdutoSalao" type="search" class="equipe-busca" placeholder="Nome do produto"/>
<div class="comanda-cardapio">@foreach(var categoria in Model.Produtos.Where(p=>p.Disponivel).GroupBy(p=>p.NomeCategoria)){
<h3>@categoria.Key</h3>@foreach(var p in categoria){<article class="equipe-box" data-produto-salao="@p.Nome"><h4>@p.Nome</h4><p>@p.Descricao</p><p><strong>@p.Preco.ToString("C",cultura)</strong></p>
<form asp-action="Adicionar" method="post" class="equipe-form"><input type="hidden" name="AtendimentoId" value="@a.Id"/><input type="hidden" name="Versao" value="@a.Versao"/><input type="hidden" name="ChaveSolicitacao" value="@Guid.NewGuid()"/><input type="hidden" name="Itens[0].ProdutoId" value="@p.Id"/>
<label for="novo-q-@p.Id">Quantidade de @p.Nome</label><input id="novo-q-@p.Id" name="Itens[0].Quantidade" type="number" min="1" max="30" value="1" required/>
<label for="novo-o-@p.Id">Observações de @p.Nome (opcional)</label><textarea id="novo-o-@p.Id" name="Itens[0].Observacao" maxlength="500" rows="2"></textarea><button type="submit">Adicionar e enviar à cozinha</button></form></article>}}
</div>}
@if(aberta&&gestor){<details class="equipe-box mt-3"><summary>Desconto / cortesia</summary><form asp-action="Desconto" method="post" class="equipe-form"><input type="hidden" name="AtendimentoId" value="@a.Id"/><input type="hidden" name="Versao" value="@a.Versao"/><input type="hidden" name="ChaveSolicitacao" value="@Guid.NewGuid()"/>
<label for="tipoDesconto">Tipo</label><select id="tipoDesconto" name="Tipo"><option value="0">Valor em reais</option><option value="1">Porcentagem</option></select><label for="valorDesconto">Valor (zero remove)</label><input id="valorDesconto" name="Valor" inputmode="decimal" value="0" required/>
<label for="motivoDesconto">Motivo</label><input id="motivoDesconto" name="Motivo" maxlength="400" required/><button type="submit">Registrar desconto</button></form></details>
<details class="equipe-box mt-3"><summary>Trocar garçom responsável</summary><form asp-action="Transferir" method="post" class="equipe-form"><input type="hidden" name="AtendimentoId" value="@a.Id"/><input type="hidden" name="Versao" value="@a.Versao"/><input type="hidden" name="ChaveSolicitacao" value="@Guid.NewGuid()"/><label for="garcomDestino">Novo responsável</label><select id="garcomDestino" name="GarcomId">@foreach(var g in Model.Garcons){<option value="@g.Id" selected="@(g.Id==a.GarcomId)">@g.Nome</option>}</select><button type="submit">Transferir atendimento</button></form></details>}
@if(aberta){<details class="equipe-box mt-3"><summary>Fechar conta</summary><form asp-action="Fechar" method="post" class="equipe-form"><input type="hidden" name="AtendimentoId" value="@a.Id"/><input type="hidden" name="Versao" value="@a.Versao"/><input type="hidden" name="ChaveSolicitacao" value="@Guid.NewGuid()"/>
<p>Total: <strong>@a.Total.ToString("C",cultura)</strong>. Registre somente o valor efetivamente recebido fora deste sistema. Não informe dados de cartão.</p>
@for(var i=0;i<3;i++){<fieldset><legend>Recebimento @(i+1)</legend><label for="meio-@i">Forma</label><select id="meio-@i" name="Pagamentos[@i].Meio"><option value="0">Dinheiro</option><option value="1">Cartão de crédito</option><option value="2">Cartão de débito</option><option value="3">Pix</option><option value="4">Outro</option></select><label for="valor-@i">Valor em reais (zero se não utilizar)</label><input id="valor-@i" name="Pagamentos[@i].Valor" inputmode="decimal" value="0" required/></fieldset>}
<label><input name="PagamentoExternoConferido" type="checkbox" value="true" required/> Conferi o recebimento do total fora do sistema.</label><p>Itens em fila, em preparo ou prontos precisam ser entregues ou corrigidos antes do fechamento. Após fechar, a mesa aguardará limpeza.</p><button type="submit">Confirmar fechamento da conta</button></form></details>}
@if(a.Situacao==SituacaoAtendimento.AguardandoLimpeza){<section class="equipe-box"><h2>Aguardando limpeza</h2><p>A conta foi fechada. Confirme a limpeza antes de disponibilizar a mesa.</p><form asp-action="Liberar" method="post"><input type="hidden" name="AtendimentoId" value="@a.Id"/><input type="hidden" name="Versao" value="@a.Versao"/><input type="hidden" name="ChaveSolicitacao" value="@Guid.NewGuid()"/><button type="submit">Mesa limpa: liberar para novo grupo</button></form></section>}
@if(a.FechadoEmUtc.HasValue){<section class="equipe-box"><h2>Recebimentos registrados</h2>@foreach(var p in a.Pagamentos){<p>@KioraRestaurante.Services.Salao.TextosSalao.Pagamento(p.Meio): @p.Valor.ToString("C",cultura)</p>}@if(a.Total==0){<p>Sem cobrança · cortesia ou comanda sem consumo.</p>}</section>}
</section></div>
<details class="equipe-box mt-4"><summary>Histórico do atendimento</summary>@foreach(var h in a.Historico){<p>@HorarioRestaurante.ParaLocal(h.DataUtc).ToString("dd/MM HH:mm") · @h.Responsavel — @h.Descricao</p>}</details>
