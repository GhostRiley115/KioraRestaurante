@model ComandaSalaoViewModel
@using KioraRestaurante.Services.Salao
@{var a=Model.Comanda;ViewData["Title"]=$"Comanda · {a.Mesa}";var c=CultureInfo.GetCultureInfo("pt-BR");var gestor=User.IsInRole("Administrador")||User.IsInRole("Gerente");var aberta=a.Situacao==SituacaoAtendimento.Aberto;var consumo=a.Itens.Where(i=>i.Situacao!=SituacaoPreparo.Cancelado).ToList();var pendentes=consumo.Where(i=>i.Situacao!=SituacaoPreparo.Entregue).ToList();}
<a asp-action="Index" class="equipe-voltar">← Voltar ao salão</a>
<header class="admin-cabecalho"><div><span class="admin-sobretitulo">ATENDIMENTO PRESENCIAL</span><h1>@a.Mesa <span class="equipe-status @(aberta?"estado-ocupada":a.Situacao==SituacaoAtendimento.AguardandoLimpeza?"estado-limpeza":"estado-inativa")">@TextosSalao.Atendimento(a.Situacao)</span></h1><p class="admin-suave">@a.NomeGrupo · @a.Pessoas pessoa(s) · Responsável: @a.Garcom<br/>Início: @HorarioRestaurante.ParaLocal(a.AbertoEmUtc).ToString("dd/MM/yyyy HH:mm")</p></div><a asp-action="Comanda" asp-route-id="@a.Id" class="admin-botao admin-botao-secundario">Atualizar atendimento</a></header>
@if(a.Situacao==SituacaoAtendimento.AguardandoLimpeza){<section class="equipe-aviso-limpeza"><div><h2>Conta fechada. Falta liberar a mesa.</h2><p>Conclua a limpeza para receber o próximo grupo.</p></div><form asp-action="Liberar" method="post"><partial name="_ChavesComanda" model="a"/><button type="submit">Mesa limpa: liberar atendimento</button></form></section>}
<div class="comanda-workspace"><div class="comanda-principal">
@if(aberta){<nav class="equipe-abas" aria-label="Tarefas da comanda"><button type="button" data-comanda-aba="consumo" aria-pressed="true">Consumo da mesa · @consumo.Sum(i=>i.Quantidade)</button><button type="button" data-comanda-aba="cardapio" aria-pressed="false">+ Adicionar itens</button></nav>}
<section data-comanda-painel="consumo"><div class="admin-secao-topo"><h2>Consumo da mesa</h2><span class="admin-suave">@consumo.Sum(i=>i.Quantidade) unidade(s)</span></div>
@if(consumo.Count==0){<div class="equipe-vazio"><h3>A mesa ainda não pediu.</h3><p>Abra “Adicionar itens”, escolha um produto e envie para a cozinha.</p></div>}
@if(pendentes.Count>0){<div class="comanda-pendentes"><h3 class="equipe-titulo-menor">Acompanhar preparo e entrega</h3>@foreach(var item in pendentes.OrderBy(i=>i.Situacao==SituacaoPreparo.Pronto?0:1).ThenBy(i=>i.EnviadoEmUtc)){<partial name="_ItemComanda" model="new ItemComandaViewModel(Model,item)"/>}</div>}
@if(consumo.Any(i=>i.Situacao==SituacaoPreparo.Entregue)){<details class="equipe-box" open="@(!aberta)"><summary>Itens entregues à mesa · @consumo.Where(i=>i.Situacao==SituacaoPreparo.Entregue).Sum(i=>i.Quantidade) unidade(s)</summary>@foreach(var item in consumo.Where(i=>i.Situacao==SituacaoPreparo.Entregue)){<partial name="_ItemComanda" model="new ItemComandaViewModel(Model,item)"/>}</details>}
</section>
@if(aberta){<section data-comanda-painel="cardapio"><h2>Adicionar itens</h2><p class="admin-suave">A conta continua aberta. Cada envio já entra na fila da cozinha.</p><div class="equipe-ferramentas"><label for="buscarProdutoSalao">Buscar no cardápio</label><input id="buscarProdutoSalao" type="search" class="equipe-busca" placeholder="Nome do prato, bebida ou sobremesa"/></div>
<div class="comanda-cardapio">@foreach(var categoria in Model.Produtos.Where(p=>p.Disponivel).GroupBy(p=>p.NomeCategoria)){
<section class="comanda-categoria" data-categoria-salao><h3>@categoria.Key</h3><div class="comanda-produtos-grid">@foreach(var p in categoria){<partial name="_ProdutoComanda" model="new ProdutoComandaViewModel(a,p)"/>}</div></section>}
<p data-produtos-vazios hidden class="equipe-vazio" role="status">Nenhum produto corresponde à busca.</p></div>
</section>}
<details class="equipe-box comanda-historico"><summary>Histórico e itens cancelados</summary>
@foreach(var item in a.Itens.Where(i=>i.Situacao==SituacaoPreparo.Cancelado)){<p><strong>@item.Quantidade × @item.Nome</strong> · cancelado, fora do total.<br/>Motivo: @item.MotivoCancelamento</p>}
@if(a.Historico.Count==0){<p class="admin-suave">Nenhuma movimentação registrada.</p>}@foreach(var h in a.Historico){<p>@HorarioRestaurante.ParaLocal(h.DataUtc).ToString("dd/MM HH:mm") · <strong>@h.Responsavel</strong><br/>@h.Descricao</p>}</details>
</div>
<aside class="comanda-resumo"><section class="equipe-box"><h2>Conta da mesa</h2><dl class="comanda-valores"><div><dt>Produtos</dt><dd>@a.Subtotal.ToString("C",c)</dd></div><div><dt>Desconto / cortesia</dt><dd>− @a.Desconto.ToString("C",c)</dd></div><div class="comanda-total"><dt>Total</dt><dd>@a.Total.ToString("C",c)</dd></div></dl>@if(!string.IsNullOrWhiteSpace(a.MotivoDesconto)){<p class="admin-suave">Motivo do desconto: @a.MotivoDesconto</p>}
@if(aberta){<p class="comanda-proximo-passo">@(pendentes.Any(i=>i.Situacao==SituacaoPreparo.Pronto)?"Há pratos prontos: retire na cozinha e confirme a entrega.":pendentes.Count>0?"Acompanhe os itens. A conta pode ser fechada depois que todos forem entregues.":"Todos os itens foram entregues. Você pode adicionar novos itens ou fechar a conta.")</p>}
</section>
@if(aberta&&gestor){<details class="equipe-box"><summary>Aplicar desconto ou cortesia</summary><form asp-action="Desconto" method="post" class="equipe-form"><partial name="_ChavesComanda" model="a"/>
<label for="tipoDesconto">Tipo de desconto</label><select id="tipoDesconto" name="Tipo"><option value="0">Valor em reais</option><option value="1">Porcentagem</option></select><label for="valorDesconto">Valor (zero remove o desconto)</label><input id="valorDesconto" name="Valor" inputmode="decimal" value="0" required/>
<label for="motivoDesconto">Motivo</label><input id="motivoDesconto" name="Motivo" maxlength="400" required/><button type="submit">Salvar desconto</button></form></details>
<details class="equipe-box"><summary>Trocar responsável pela mesa</summary><form asp-action="Transferir" method="post" class="equipe-form"><partial name="_ChavesComanda" model="a"/><label for="garcomDestino">Novo garçom responsável</label><select id="garcomDestino" name="GarcomId">@foreach(var g in Model.Garcons){<option value="@g.Id" selected="@(g.Id==a.GarcomId)">@g.Nome</option>}</select><button type="submit">Transferir atendimento</button></form></details>}
@if(aberta){<partial name="_FechamentoComanda" model="a"/>}
@if(a.FechadoEmUtc.HasValue){<section class="equipe-box"><h2>Conta encerrada</h2><p class="admin-suave">Fechada em @HorarioRestaurante.ParaLocal(a.FechadoEmUtc.Value).ToString("dd/MM/yyyy HH:mm").</p>@foreach(var pagamento in a.Pagamentos){<p>@TextosSalao.Pagamento(pagamento.Meio): <strong>@pagamento.Valor.ToString("C",c)</strong></p>}@if(a.Total==0){<p>Sem cobrança · cortesia ou comanda sem consumo.</p>}</section>}
</aside></div>
