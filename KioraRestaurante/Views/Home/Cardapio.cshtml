@model KioraRestaurante.ViewModels.CardapioViewModel
@using System.Globalization
@using KioraRestaurante.Services.Cardapio

@{
    ViewData["Title"] = "Cardápio";
    var rotasFiltros = new Dictionary<string, string>
    {
        ["busca"] = Model.Filtros.Busca ?? "",
        ["precoMinimo"] = Model.Filtros.PrecoMinimo ?? "",
        ["precoMaximo"] = Model.Filtros.PrecoMaximo ?? "",
        ["ordenacao"] = Model.Filtros.Ordenacao ?? "padrao",
        ["somenteDisponiveis"] = Model.Filtros.SomenteDisponiveis ? "true" : "false",
        ["somentePromocoes"] = Model.Filtros.SomentePromocoes ? "true" : "false"
    };
    // Cada link recebe seu próprio conjunto de parâmetros.
    Dictionary<string, string> RotasDaCategoria(int? id) => new(rotasFiltros)
    {
        ["categoriaId"] = id?.ToString(CultureInfo.InvariantCulture) ?? "",
        ["colecao"] = ""
    };
    Dictionary<string, string> RotasDaColecao(string colecao) => new(rotasFiltros)
    {
        ["categoriaId"] = "",
        ["colecao"] = colecao
    };
    var todosSelecionado = Model.CategoriaSelecionadaId == null
        && string.IsNullOrEmpty(Model.Filtros.Colecao);
}

<!-- ============================================================
     PÁGINA DO CARDÁPIO KIORA
     ============================================================ -->
<section class="cardapio-kiora">
    <!-- ========================================================
         CABEÇALHO DO CARDÁPIO
         ======================================================== -->
    <div class="cardapio-cabecalho">
        <span class="cardapio-subtitulo sobre-label">UMA EXPERIÊNCIA ALÉM DO SABOR</span>
        <h1>Nosso cardápio</h1>
        <p>Uma seleção inspirada nas tradicionais casas de lámen do Japão, reunindo caldos preparados lentamente,
            macarrão de textura artesanal e ingredientes cuidadosamente selecionados.</p>
    </div>

    <!-- Confirmação exibida após o cadastro de um produto. -->
    @if (TempData["ProdutoSucesso"] is string mensagem)
    {
        <div class="alert alert-success" role="status">@mensagem</div>
    }

    <!-- ========================================================
         CONTEÚDO PRINCIPAL
         ======================================================== -->
    <div class="cardapio-conteudo">
        <!-- ====================================================
             MENU LATERAL DE CATEGORIAS
             ==================================================== -->
        <aside class="cardapio-categorias">
            <div class="categorias-card">
                <div class="categorias-titulo">
                    <span><i class="bi bi-list" aria-hidden="true"></i></span>
                    <h2>Categorias</h2>
                </div>
                <nav class="categorias-menu" aria-label="Categorias do cardápio">
                    <!-- Todos é um filtro sem categoriaId, não uma categoria do banco. -->
                    <a asp-controller="Home" asp-action="Cardapio" asp-all-route-data="RotasDaCategoria(null)"
                       class="categoria-item @(todosSelecionado ? "ativo" : "")"
                       aria-current="@(todosSelecionado ? "page" : null)">
                        <partial name="_IconeCategoria" model='@("Todos")' /><span>Todos</span>
                    </a>
                    <!-- Coleções automáticas: não são registros da tabela Categorias. -->
                    @foreach (var colecao in ColecoesCardapio.Nomes)
                    {
                        var selecionada = Model.Filtros.Colecao == colecao.Key;
                        <a asp-controller="Home" asp-action="Cardapio"
                           asp-all-route-data="RotasDaColecao(colecao.Key)"
                           class="categoria-item @(selecionada ? "ativo" : "")"
                           aria-current="@(selecionada ? "page" : null)">
                            <partial name="_IconeCategoria" model="colecao.Value" />
                            <span>@colecao.Value</span>
                        </a>
                    }
                    @foreach (var categoria in Model.Categorias)
                    {
                        var selecionada = Model.CategoriaSelecionadaId == categoria.Id;
                        <a asp-controller="Home" asp-action="Cardapio" asp-all-route-data="RotasDaCategoria(categoria.Id)"
                           class="categoria-item @(selecionada ? "ativo" : "")"
                           aria-current="@(selecionada ? "page" : null)">
                            <partial name="_IconeCategoria" model="categoria.Nome" /><span>@categoria.Nome</span>
                        </a>
                    }
                </nav>
            </div>
        </aside>

        <!-- ====================================================
             ÁREA DOS PRODUTOS
             ==================================================== -->
        <div class="cardapio-produtos">
            <div class="categoria-cabecalho">
                <div>
                    <span class="categoria-label">CARDÁPIO KIORA</span>
                    <h2>@Model.Titulo</h2>
                </div>
            </div>

            @if (Model.PeriodoMaisPedidos != null)
            {
                <p class="cardapio-contagem">@Model.PeriodoMaisPedidos</p>
            }

            <partial name="_FiltrosCardapio" model="Model" />

            @if (Model.ErrosFiltros.Count > 0)
            {
                <div class="cardapio-erros" role="alert">
                    <p>Confira os filtros:</p>
                    <ul>
                        @foreach (var erro in Model.ErrosFiltros)
                        {
                            <li>@erro</li>
                        }
                    </ul>
                </div>
            }
            else
            {
                <p class="cardapio-contagem" role="status">
                    @Model.Produtos.Count produto(s) encontrado(s).
                </p>

                <!-- Estado vazio: evita uma área sem explicação quando não há produtos. -->
                @if (Model.Produtos.Count == 0)
                {
                    @if (Model.Filtros.Colecao == ColecoesCardapio.MaisPedidos)
                    {
                        <p>Nenhum produto com vendas válidas neste período corresponde aos filtros.</p>
                    }
                    else
                    {
                        <p>Nenhum produto corresponde aos filtros. Altere a busca ou limpe os filtros.</p>
                    }
                }

                @foreach (var secao in Model.Secoes)
                {
                    <div class="cardapio-secao" id="secao-@secao.Id">
                        @if (Model.ExibirSeparadores)
                        {
                            <h2 class="cardapio-separador">@secao.Titulo</h2>
                        }

                        <!-- Um card para cada produto devolvido pelo serviço. -->
                        <div class="produtos-grid">
                            @foreach (var produto in secao.Produtos)
                            {
                                <partial name="_CardProduto" model="produto" />
                            }
                        </div>
                    </div>
                }
            }
        </div>
    </div>
    <noscript><p>Ative o JavaScript para adicionar produtos ao carrinho.</p></noscript>
</section>

<!-- A filtragem usa links; carrinho.js, carregado no layout, controla a compra.
     Não carregar o antigo cardapio.js, que apenas simulava a adição. -->
