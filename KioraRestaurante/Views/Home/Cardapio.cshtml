@model KioraRestaurante.ViewModels.CardapioViewModel
@using System.Globalization

@{
    ViewData["Title"] = "Cardápio";
    var cultura = CultureInfo.GetCultureInfo("pt-BR");
}

<!-- ============================================================
     PÁGINA DO CARDÁPIO KIORA
     ============================================================ -->
<section class="cardapio-kiora">
    <!-- ========================================================
         CABEÇALHO DO CARDÁPIO
         ======================================================== -->
    <div class="cardapio-cabecalho">
        <span class="cardapio-subtitulo sobre-label">UMA EXPERIÊNCIA ALÉM DO SABOR</span>
        <h1>Nosso cardápio</h1>
        <p>Uma seleção inspirada nas tradicionais casas de ramen do Japão, reunindo caldos preparados lentamente,
            macarrão de textura artesanal e ingredientes cuidadosamente selecionados.</p>
    </div>

    <!-- Confirmação exibida após o cadastro de um produto. -->
    @if (TempData["ProdutoSucesso"] is string mensagem)
    {
        <div class="alert alert-success" role="status">@mensagem</div>
    }

    <!-- ========================================================
         CONTEÚDO PRINCIPAL
         ======================================================== -->
    <div class="cardapio-conteudo">
        <!-- ====================================================
             MENU LATERAL DE CATEGORIAS
             ==================================================== -->
        <aside class="cardapio-categorias">
            <div class="categorias-card">
                <div class="categorias-titulo">
                    <span><i class="bi bi-list" aria-hidden="true"></i></span>
                    <h2>Categorias</h2>
                </div>
                <nav class="categorias-menu" aria-label="Categorias do cardápio">
                    <!-- Todos é um filtro sem categoriaId, não uma categoria do banco. -->
                    <a asp-controller="Home" asp-action="Cardapio" asp-route-categoriaId=""
                       class="categoria-item @(Model.CategoriaSelecionadaId == null ? "ativo" : "")"
                       aria-current="@(Model.CategoriaSelecionadaId == null ? "page" : null)">
                        <partial name="_IconeCategoria" model='@("Todos")' /><span>Todos</span>
                    </a>
                    @foreach (var categoria in Model.Categorias)
                    {
                        var selecionada = Model.CategoriaSelecionadaId == categoria.Id;
                        <a asp-controller="Home" asp-action="Cardapio" asp-route-categoriaId="@categoria.Id"
                           class="categoria-item @(selecionada ? "ativo" : "")"
                           aria-current="@(selecionada ? "page" : null)">
                            <partial name="_IconeCategoria" model="categoria.Nome" /><span>@categoria.Nome</span>
                        </a>
                    }
                </nav>
            </div>
        </aside>

        <!-- ====================================================
             ÁREA DOS PRODUTOS
             ==================================================== -->
        <div class="cardapio-produtos">
            <div class="categoria-cabecalho">
                <div>
                    <span class="categoria-label">CARDÁPIO KIORA</span>
                    <h2>@Model.Titulo</h2>
                </div>
            </div>

            <!-- Estado vazio: evita uma área sem explicação quando não há produtos. -->
            @if (Model.Produtos.Count == 0)
            {
                <p role="status">Nenhum produto cadastrado nesta categoria por enquanto.</p>
            }

            <!-- Um card para cada produto devolvido pelo serviço. -->
            <div class="produtos-grid">
                @foreach (var produto in Model.Produtos)
                {
                    <article class="produto-card">
                        <!-- FOTO: produtos sem imagem recebem um ícone de substituição. -->
                        <div class="produto-imagem">
                            @if (!string.IsNullOrWhiteSpace(produto.ImagemUrl))
                            {
                                <img src="@Url.Content(produto.ImagemUrl)" alt="@produto.Nome" loading="lazy" />
                            }
                            else
                            {
                                <div class="produto-imagem-placeholder" aria-hidden="true"><i class="bi bi-image"></i></div>
                            }
                        </div>
                        <div class="produto-informacoes">
                            <span class="categoria-label">@produto.NomeCategoria</span>
                            <h3>@produto.Nome</h3>
                            <p>@produto.Descricao</p>
                            <div class="produto-rodape">
                                <span class="produto-preco">@produto.Preco.ToString("C", cultura)</span>
                            </div>

                            <!-- COMPRA: os identificadores abaixo conectam o card ao carrinho.js. -->
                            @if (produto.Disponivel)
                            {
                                <form class="kc-compra" data-produto-id="@produto.Id">
                                    <label for="quantidade-@produto.Id">Quantidade</label>
                                    <div class="produto-controles">
                                        <button type="button" data-seletor="-1" data-carrinho-mutacao disabled
                                                aria-label="Diminuir quantidade de @produto.Nome">−</button>
                                        <input id="quantidade-@produto.Id" name="quantidade" type="number"
                                               min="1" max="30" step="1" value="1" required data-carrinho-mutacao disabled />
                                        <button type="button" data-seletor="1" data-carrinho-mutacao disabled
                                                aria-label="Aumentar quantidade de @produto.Nome">+</button>
                                    </div>
                                    <button type="submit" class="btn-adicionar-produto" data-carrinho-mutacao disabled>
                                        <i class="bi bi-plus-lg" aria-hidden="true"></i><span>Adicionar</span>
                                    </button>
                                </form>
                            }
                            else
                            {
                                <!-- INDISPONÍVEL: continua visível, sem permitir uma nova compra. -->
                                <p class="produto-indisponivel">Indisponível no momento</p>
                            }
                        </div>
                    </article>
                }
            </div>
        </div>
    </div>
    <noscript><p>Ative o JavaScript para adicionar produtos ao carrinho.</p></noscript>
</section>

<!-- A filtragem usa links; carrinho.js, carregado no layout, controla a compra.
     Não carregar o antigo cardapio.js, que apenas simulava a adição. -->
