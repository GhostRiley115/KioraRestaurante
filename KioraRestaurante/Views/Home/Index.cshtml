@{
    // Identifica esta View como a página inicial do site.
    // O _Layout.cshtml pode utilizar esta informação
    // para aplicar comportamentos ou estilos específicos da Home.
    ViewData["HomePage"] = true;
    ViewData["Title"] = "Início";
    var administrador = User.IsInRole("Administrador");
}
@section Styles {
    <link rel="stylesheet" href="~/css/home.css" asp-append-version="true" />
}

<!--
    HERO - PÁGINA INICIAL

    Área principal da página inicial da KIORA.

    Contém:
    - Subtítulo;
    - Título principal;
    - Descrição;
    - Botões de Login e Cadastro.
-->

<section class="hero-kiora @(administrador ? "home-administrador" : "")" aria-labelledby="tituloHome">
    <partial name="_ImagemHome" model='@("fundo-kiora1")' />

    <!--
        Overlay escuro sobre a imagem de fundo.

        Sua função é melhorar a leitura dos textos apresentados sobre a imagem.
    -->
    <div class="hero-overlay"></div>

        <!--
            Conteúdo principal da Hero.
        -->
        <div class="hero-conteudo">

            <div class="container">

                @if (administrador)
                {
                    <span class="hero-subtitulo">KIORA · ÁREA DE GESTÃO</span>
                    <h1 id="tituloHome">Olá, <span class="hero-nome-usuario">@(User.Identity?.Name ?? "equipe Kiora").</span><br />Vamos cuidar da operação?</h1>
                    <p>Pedidos, catálogo e clientes: encontre o que precisa para organizar o atendimento em um só lugar.</p>
                    <div class="hero-botoes">
                        <a asp-controller="Admin" asp-action="Pedidos" class="btn btn-login">Ver pedidos</a>
                        <a asp-controller="Admin" asp-action="Index" class="btn btn-cadastrar">Abrir painel de gestão</a>
                    </div>
                }
                else if (User.Identity?.IsAuthenticated == true)
                {
                    <!--
                        =========================================================
                        HERO PARA USUÁRIO AUTENTICADO
                        =========================================================

                        Apresenta uma saudação personalizada ao usuário,
                        mantendo a identidade visual institucional da KIORA.
                    -->

                    <span class="hero-subtitulo">
                        EXPERIÊNCIA KIORA
                    </span>

                    <h1 id="tituloHome">
                        Olá,
                        <span class="hero-nome-usuario">
                            @User.Identity.Name!
                        </span>
                    </h1>

                    <p>
                        Seu próximo momento Kiora começa aqui. Explore o cardápio,
                        acompanhe seus pedidos e mantenha seus dados de entrega em dia.
                    </p>


                    <!--
                        BOTÕES PARA USUÁRIO AUTENTICADO
                    -->
                    <div class="hero-botoes">

                        <!--
                            BOTÃO PRINCIPAL

                            Direciona o usuário para o Cardápio.
                        -->
                        <a asp-controller="Home"
                           asp-action="Cardapio"
                           class="btn btn-login">

                            Ver Cardápio

                        </a>


                        <!--
                            BOTÃO SECUNDÁRIO

                            Direciona o usuário para seu perfil.
                        -->
                        <!-- Atualização: o atalho principal agora abre os pedidos; o perfil continua no menu da conta. -->
                        <a asp-controller="Pedido"
                           asp-action="MeusPedidos"
                           class="btn btn-cadastrar">

                            Meus pedidos

                        </a>

                    </div>
                }
                else
                {
                    <!--
                        =========================================================
                        HERO PARA USUÁRIO NÃO AUTENTICADO
                        =========================================================

                        Mantém a apresentação original da KIORA.
                    -->

                    <span class="hero-subtitulo">
                        SABORES DO JAPÃO
                    </span>


                    <h1 id="tituloHome">
                        Tradição, sabor<br />
                        e sofisticação.
                    </h1>


                    <p>
                        Da escolha do lámen ao acompanhamento do pedido, descubra a Kiora no seu ritmo.
                        Explore nosso cardápio e encontre o sabor do seu próximo encontro com a culinária japonesa.
                    </p>


                    <!--
                        BOTÕES PARA USUÁRIO NÃO AUTENTICADO
                    -->
                    <div class="hero-botoes">

                        <!--
                            BOTÃO LOGIN

                            Abre o Modal de Login.
                        -->
                        <a href="#"
                           class="btn btn-login"
                           data-bs-toggle="modal"
                           data-bs-target="#modalLogin">

                            Fazer Login

                        </a>


                        <!--
                            BOTÃO CADASTRO

                            Abre o Modal de Cadastro.
                        -->
                        <a href="#"
                           class="btn btn-cadastrar"
                           data-bs-toggle="modal"
                           data-bs-target="#modalCadastro">

                            Cadastrar

                        </a>

                    </div>
                }

            </div>

        </div>


</section>



<!--
    CARDS DE DESTAQUE DA PÁGINA INICIAL 

    IMPORTANTE:

    Esta seção pertence SOMENTE à página inicial.

    Ela está dentro do Index.cshtml e NÃO deve ser colocada
    no _Layout.cshtml.

    Dessa forma, os quatro cards aparecerão somente na Home.

    Cards:
    1. Cardápio
    2. Mais vendidos
    3. Promoções
    4. Produtos KIORA
-->

<partial name="_InicioPorPerfil" />

@if (!administrador)
{
<section class="kiora-destaques" aria-labelledby="tituloDestaques">


    <!--
        Container de largura total.

        px-3: Define espaçamento lateral em telas pequenas.

        px-lg-4: Define espaçamento lateral maior em telas grandes.
    -->
    <div class="container home-secao-cabecalho">
        <span class="home-sobretitulo">EXPLORE A KIORA</span>
        <h2 id="tituloDestaques">Um sabor para cada momento.</h2>
        <p>Comece pelo cardápio. Novas formas de descobrir nossos produtos chegam em breve.</p>
    </div>
    <div class="container px-3 px-lg-4">


        <!--
            Linha responsável pela organização dos quatro cards.

            g-2: Define o espaçamento entre os cards.
        -->
        <div class="row g-2">


            <!--
                CARD 1 - CARDÁPIO 
            -->

            <!--
                col-12: Ocupa toda a largura em telas pequenas.

                col-md-6: Ocupa metade da largura em telas médias.

                col-lg-3: Ocupa 1/4 da largura em telas grandes.
            -->
            <div class="col-12 col-md-6 col-lg-3">


                <!--
                    O card inteiro funciona como área clicável.

                    Por enquanto, href="#" é utilizado como placeholder.

                    Posteriormente podemos substituir pelo endereço da página real do Cardápio.
                -->
                <!-- O cardápio agora está disponível; a rota abaixo substitui o placeholder descrito acima. -->
                <a asp-controller="Home" asp-action="Cardapio"
                   class="destaque-card">


                    <!--
                        Imagem de fundo do card.

                        Arquivo: wwwroot/imagens/cardapio-card.png
                    -->
                    <partial name="_ImagemHome" model='@("cardapio-card")' />


                    <!--
                        Overlay escuro sobre a imagem.
                    -->
                    <div class="destaque-overlay"></div>


                    <!--
                        Conteúdo textual do card.
                    -->
                    <div class="destaque-conteudo">


                        <!-- Categoria do card -->
                        <span class="destaque-subtitulo">
                            CARDÁPIO
                        </span>


                        <!-- Título do card -->
                        <h3>
                            Sabores que conquistam.
                        </h3>


                        <!-- Descrição do card -->
                        <p>
                            Descubra nossos lámens, acompanhamentos
                            e sobremesas.
                        </p>


                        <!-- Ação do card -->
                        <span class="destaque-link">
                            → VER CARDÁPIO
                        </span>


                    </div>

                </a>

            </div>



            <!--
                CARD 2 - MAIS VENDIDOS 
            -->
            <!-- Aqui vai o link para o filtro de produtos mais pedidos. -->

            <div class="col-12 col-md-6 col-lg-3">


                <!--
                    Área clicável de todo o card.
                -->
                <article class="destaque-card destaque-em-breve">


                    <!--
                        Imagem de fundo do card.

                        Arquivo: wwwroot/imagens/mais-vendido.png
                    -->
                    <partial name="_ImagemHome" model='@("mais-vendido")' />


                    <!--
                        Overlay escuro sobre a imagem.
                    -->
                    <div class="destaque-overlay"></div>


                    <!--
                        Conteúdo textual do card.
                    -->
                    <div class="destaque-conteudo">


                        <!-- Categoria do card -->
                        <span class="destaque-subtitulo">
                            MAIS VENDIDOS
                        </span>


                        <!-- Título do card -->
                        <h3>
                            Os favoritos da Kiora.
                        </h3>


                        <!-- Descrição do card -->
                        <p>
                            Uma seleção dos pratos mais pedidos
                            estará disponível aqui.
                        </p>


                        <!-- Ação do card -->
                        <span class="destaque-link">
                            EM BREVE · MAIS VENDIDOS
                        </span>


                    </div>

                </article>

            </div>



            <!--
                CARD 3 - PROMOÇÕES  
            -->
            <!-- Aqui vai o link para o filtro de promoções. -->

            <div class="col-12 col-md-6 col-lg-3">


                <!--
                    Área clicável de todo o card.
                -->
                <article class="destaque-card destaque-em-breve">


                    <!--
                        Imagem de fundo do card.

                        Arquivo: wwwroot/imagens/promocao.png
                    -->
                    <partial name="_ImagemHome" model='@("promocao")' />


                    <!--
                        Overlay escuro sobre a imagem.
                    -->
                    <div class="destaque-overlay"></div>


                    <!--
                        Conteúdo textual do card.
                    -->
                    <div class="destaque-conteudo">


                        <!-- Categoria do card -->
                        <span class="destaque-subtitulo">
                            PROMOÇÕES
                        </span>


                        <!-- Título do card -->
                        <h3>
                            Uma experiência ainda melhor.
                        </h3>


                        <!-- Descrição do card -->
                        <p>
                            Em breve, reúna as combinações e ofertas
                            disponíveis em uma só página.
                        </p>


                        <!-- Ação do card -->
                        <span class="destaque-link">
                            EM BREVE · PROMOÇÕES
                        </span>


                    </div>

                </article>

            </div>



            <!--
                CARD 4 - PRODUTOS KIORA 
            -->
            <!-- Aqui vai o link para a página da linha de produtos Kiora. -->

            <div class="col-12 col-md-6 col-lg-3">


                <!--
                    Área clicável de todo o card.
                -->
                <article class="destaque-card destaque-em-breve">


                    <!--
                        Imagem de fundo do card.

                        Arquivo: wwwroot/imagens/produtos.png
                    -->
                    <partial name="_ImagemHome" model='@("produtos")' />


                    <!--
                        Overlay escuro sobre a imagem.
                    -->
                    <div class="destaque-overlay"></div>


                    <!--
                        Conteúdo textual do card.
                    -->
                    <div class="destaque-conteudo">


                        <!-- Categoria do card -->
                        <span class="destaque-subtitulo">
                            PRODUTOS KIORA
                        </span>


                        <!-- Título do card -->
                        <h3>
                            Muito além do lámen.
                        </h3>


                        <!-- Descrição do card -->
                        <p>
                            Um espaço para explorar a linha Kiora está sendo preparado.
                        </p>


                        <!-- Ação do card -->
                        <span class="destaque-link">
                            EM BREVE · PRODUTOS KIORA
                        </span>


                    </div>

                </article>

            </div>


        </div>

    </div>

</section>


}
<section class="home-ajuda container" aria-labelledby="tituloAjuda">
    <div><span class="home-sobretitulo">PRECISA DE UMA MÃO?</span>
        <h2 id="tituloAjuda">Informação também faz parte da experiência.</h2>
        <p>Conheça a Kiora ou consulte como seus dados são utilizados.</p></div>
    <div class="home-atalhos">
        <a asp-controller="Home" asp-action="Sobre">Sobre a Kiora <span aria-hidden="true">→</span></a>
        <a asp-controller="Home" asp-action="PoliticaPrivacidade">Privacidade <span aria-hidden="true">→</span></a>
        <a asp-controller="Home" asp-action="TermosUso">Termos de Uso <span aria-hidden="true">→</span></a>
    </div>
</section>
